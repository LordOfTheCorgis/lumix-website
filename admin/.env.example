# copy to admin/.env on the box that runs the admin. never commit the real one.
GITHUB_REPO=LordOfTheCorgis/lumix-website
# fine-grained PAT, this repo only. permissions: Contents read+write, Actions read.
GITHUB_TOKEN=
# branches: saves land on EDIT_BRANCH, "go live" also writes LIVE_BRANCH
EDIT_BRANCH=dev
LIVE_BRANCH=main
PORT=4322
HOST=127.0.0.1
# set both to 1 once it sits behind nginx + https
COOKIE_SECURE=1
TRUST_PROXY=1
# to try it on a local checkout with no github: ADMIN_FS_ROOT=/path/to/repo
