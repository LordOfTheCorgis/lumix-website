# PostHog. Without these the analytics script and the cookie banner both render
# nothing at all, which is what you want in dev.
# Project API key from PostHog: Settings > Project > Project API Key.
PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Trustpilot TrustBox. Both come from the embed snippet in the Trustpilot
# Business account: Integrations > TrustBox > pick a template > copy code.
# Without both, the reviews section renders nothing at all.
PUBLIC_TRUSTPILOT_BUSINESSUNIT_ID=
PUBLIC_TRUSTPILOT_TEMPLATE_ID=
# Match whatever height the template you picked is documented with.
PUBLIC_TRUSTPILOT_HEIGHT=350px
