---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("legal");
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<Layout title={doc.data.title} description={doc.data.description}>
  <article class="section">
    <div class="shell max-w-3xl">
      <p class="instrument text-fog">Last updated {doc.data.lastUpdated}</p>
      <h1 class="display-l mt-6">{doc.data.title}</h1>

      <div class="legal-prose mt-12">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  /* scoped. legal is the only long prose on the site, not worth a prose plugin */
  .legal-prose {
    overflow-wrap: anywhere;
  }

  .legal-prose :global(.legal-table) {
    margin-block: 1.5rem 2rem;
    overflow-x: auto;
    border: 1px solid var(--edge-strong);
    background: var(--color-ink);
  }

  .legal-prose :global(table) {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .legal-prose :global(.legal-table-wide table) {
    min-width: 42rem;
  }

  .legal-prose :global(th),
  .legal-prose :global(td) {
    padding: 1rem 1.25rem;
    text-align: left;
    vertical-align: top;
  }

  .legal-prose :global(th) {
    background: var(--color-ink-soft);
    color: var(--color-paper);
    font-weight: 600;
    border-bottom: 1px solid var(--edge-strong);
  }

  .legal-prose :global(th:first-child) {
    width: 30%;
  }

  .legal-prose :global(td) {
    color: var(--color-fog);
  }

  .legal-prose :global(td:first-child) {
    color: var(--color-paper);
    font-weight: 500;
  }

  .legal-prose :global(tbody tr + tr) {
    border-top: 1px solid var(--edge);
  }

  .legal-prose :global(th + th),
  .legal-prose :global(td + td) {
    border-left: 1px solid var(--edge);
  }

  .legal-prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--edge);
  }

  .legal-prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .legal-prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    margin-top: 2rem;
    color: var(--color-paper);
  }

  .legal-prose :global(p),
  .legal-prose :global(li) {
    color: var(--color-fog);
    margin-top: 1rem;
    max-width: 65ch;
  }

  .legal-prose :global(ul) {
    margin-top: 1rem;
    list-style: none;
    padding-left: 0;
  }

  .legal-prose :global(li) {
    position: relative;
    padding-left: 1.25rem;
  }

  /* square bullet, everything else here has cut corners */
  .legal-prose :global(li)::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 4px;
    height: 4px;
    background: var(--color-slate);
  }

  .legal-prose :global(a) {
    color: var(--color-red);
    text-underline-offset: 3px;
    text-decoration: underline;
  }
</style>
