---
// Where the nodes are and what your ping to each one is. One page, four
// anchors, rather than four thin pages: there isn't enough per region to
// carry a page each yet, and one strong page ranks better than four weak
// ones. The ping rows grey out until a region has a pingUrl in
// src/lib/locations.ts; that's the whole mechanism, no status flag.
import Layout from "../layouts/Layout.astro";
import PingTest from "../components/PingTest.astro";
import Globe from "../components/Globe.astro";
import { HOSTING, MITIGATION, AVAILABILITY_LABEL } from "../lib/locations";
import { NODES } from "../lib/hardware";
import { links } from "../config";

const live = HOSTING.filter((r) => r.pingUrl).length;
const open = HOSTING.filter((r) => r.availability === "open");
const nodeFor = (slug?: string) => NODES.find((n) => n.region === slug);
---

<Layout
  title="Regions and ping"
  description={`Where Lumix servers run: ${HOSTING.map((r) => `${r.city} (${AVAILABILITY_LABEL[r.availability ?? "soon"].toLowerCase()})`).join(", ")}. Measure your ping to each from your browser.`}
>
  <section class="section border-b border-[var(--edge)]">
    <div class="shell cell-split">
      <div>
        <div data-snap>
        <p class="instrument text-fog">Regions · {HOSTING.length} US · {MITIGATION.length} scrubbing points</p>
        <h1 class="display-xl mt-6 max-w-2xl">Where the servers are<span class="text-red">.</span></h1>
        <p class="lead text-fog mt-6 max-w-lg">
          We cap every region, so some fill up. Pick the open one closest to
          most of your players; the ping test below says which that is.
        </p>
        </div>
        <PingTest all class="mt-10" />
      </div>
      <Globe class="lg:ml-auto" />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-4" data-snap>
        <h2 class="title">Each region</h2>
        <p class="instrument text-slate">{open.length} of {HOSTING.length} taking orders · {live} with a ping endpoint</p>
      </div>

      <!-- Small cards on purpose: there are four facts per region, and the
           old seven-cell cards padded them out with coordinates and a games
           count nobody needed. Evan cut both 2026-10-08. -->
      <div class="cell-cols mt-10 [--cols:1] sm:[--cols:2] lg:[--cols:4]">
        {HOSTING.map((r) => {
          const node = nodeFor(r.slug);
          const av = r.availability ?? "soon";
          return (
            <article
              id={r.slug}
              data-snap
              class:list={[
                "scroll-mt-24 flex flex-col border border-[var(--edge)] p-5",
                av !== "open" && "opacity-60",
              ]}
            >
              <div class="flex items-center justify-between gap-3">
                <span class="instrument text-fog">{r.region}</span>
                <span class:list={["instrument", av === "open" ? "text-paper" : "text-slate"]}>
                  {AVAILABILITY_LABEL[av]}
                </span>
              </div>
              <h3 class="title mt-3">{r.city}</h3>
              <p class="small text-fog mt-2 flex-1">{r.serves}</p>
              {node && (
                <a href={`/hardware#${r.slug}`} class="small mt-4 inline-flex items-center gap-1.5 text-paper hover:text-red">
                  {node.cpu.replace("AMD ", "")} <span aria-hidden="true">&rarr;</span>
                </a>
              )}
            </article>
          );
        })}
      </div>

      <p class="small text-fog mt-8 max-w-2xl">
        Attack traffic gets scrubbed before it reaches any of these, at{" "}
        {MITIGATION.length} points from {MITIGATION[0].city} to {MITIGATION[MITIGATION.length - 1].city}.
        A flood aimed at your server hits a scrubbing centre first and the
        clean part carries on.
      </p>
    </div>
  </section>

  <section class="section band border-t border-[var(--edge)]">
    <div class="shell cell-split">
      <div class="cell-stack">
        <h2 class="title">Which one?</h2>
        <p class="lead text-fog mt-6 max-w-lg">
          Lowest number wins. For a community spread across the country,
          Dallas splits the difference. For Europe, Ashburn, once it has room again.
        </p>
        <a
          href="/games"
          data-snap="both"
          class="chamfer inline-flex h-10 items-center gap-2 bg-red px-7 font-medium text-ink transition-colors duration-150 hover:bg-red-pressed"
        >
          Pick a game
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <dl class="m-0">
        {[
          ["Does every game go in every region?", "Yes, same plans and same prices everywhere. You pick the region on the game page; a sold-out one is greyed out there until space opens."],
          ["Can I move regions later?", "Ask on a ticket. A move between two of our own nodes is a copy, not an import, so it's the quick kind."],
          ["What does the ping test actually measure?", "A handful of no-cors fetches from your browser to something in that datacentre, median of the last four. It isn't the game's netcode but it's the same path."],
        ].map(([q, a]) => (
          <div class="border-t border-[var(--edge)] py-5 first:border-t-0 first:pt-0" data-snap>
            <dt class="text-paper">{q}</dt>
            <dd class="small text-fog m-0 mt-2">{a}</dd>
          </div>
        ))}
        <div class="border-t border-[var(--edge)] py-5" data-snap>
          <dt class="text-paper">Still not sure?</dt>
          <dd class="small text-fog m-0 mt-2">
            Say where your players are in{" "}
            <a href={links.discord} rel="noopener" class="text-paper underline underline-offset-4 hover:text-red">Discord</a>{" "}
            and someone will tell you.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>
