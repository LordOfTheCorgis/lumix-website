---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GameTile from "../components/GameTile.astro";
import LightRays from "../components/LightRays.astro";
import HeroArt from "../components/HeroArt.astro";
import Faq from "../components/Faq.astro";
import Included from "../components/Included.astro";
import PingTest from "../components/PingTest.astro";
import Globe from "../components/Globe.astro";
import { orderUrl, price } from "../lib/order";
import { HOSTING, MITIGATION } from "../lib/locations";
import { botHosting, links, trust } from "../config";

const botUrl = botHosting.pid ? orderUrl(botHosting.pid) : links.billing;

const games = (await getCollection("games"))
  .filter((g) => g.data.status === "live")
  .sort((a, b) => a.data.shortLabel.localeCompare(b.data.shortLabel));

const cheapest = Math.min(
  ...games.flatMap((g) => g.data.plans.map((p) => p.pricing.monthly))
);
---

<Layout
  title="Order a game server | Lumix Solutions"
  description={`FiveM, Minecraft, Palworld, BeamMP and Terraria servers from ${price(cheapest)} a month. Four US regions, DDoS protected, online in minutes.`}
>
  <!-- One job: get someone into a cart. No positioning copy, no engineering
       story, no stat bar. Those can live further down the page later. -->
  <section class="section relative overflow-hidden">
    <!-- Order matters: art, then light on top of it, then copy. All three are
         positioned so DOM order is the stack. -->
    <HeroArt
      games={games.map((g) => ({ slug: g.data.slug, image: g.data.image, accent: g.data.accent }))}
    />
    <LightRays />

    <div class="shell relative">
      <p class="instrument text-fog">Game servers · Four US regions</p>
      <!-- The proof line. Every competitor puts the score above the fold;
           ours was a paid widget at the bottom of the page until 09-11. -->
      {trust.score !== null && trust.reviews !== null && (
        <a
          href={trust.url}
          rel="noopener"
          class="small mt-4 inline-flex items-center gap-2 text-fog hover:text-paper"
        >
          <span class="text-paper" aria-hidden="true">★</span>
          <span><span class="text-paper font-medium">{trust.score.toFixed(1)}</span> · {trust.reviews} reviews on Trustpilot</span>
        </a>
      )}

      <h1 class="display-xl mt-6 max-w-3xl">Order your game server.</h1>

      <p class="lead text-fog mt-6 max-w-lg">
        Pick your game, pick a size, and it's online in minutes. Plans start at {price(cheapest)} a month.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="#pick"
          class="chamfer inline-flex items-center gap-2 bg-red px-7 py-4 font-medium text-ink transition-colors duration-150 hover:bg-red-pressed"
        >
          Order now
          <span aria-hidden="true">&rarr;</span>
        </a>
        <!-- The code lives in the bar above the header now; saying it twice
             in one viewport looked like we were nervous about it. -->
        <p class="small text-fog">No setup fee. Cancel anytime.</p>
      </div>
    </div>
  </section>

  <section id="pick" class="section lit lit-tl border-t border-[var(--edge)] pt-12 lg:pt-16">
    <div class="shell">
      <h2 class="title">Pick your game</h2>

      <!-- Gutter is exactly one cell wide, and this row is what the trail
           registers to vertically. Change the gap and the cells go back to
           straddling the tile edges. -->
      <div
        data-grid-anchor
        class="mt-8 grid gap-[var(--grid-cell)] sm:grid-cols-2 lg:grid-cols-3"
      >
        {games.map((game, i) => (
          <GameTile
            slug={game.data.slug}
            name={game.data.shortLabel}
            tagline={game.data.tagline}
            image={game.data.image}
            from={Math.min(...game.data.plans.map((p) => p.pricing.monthly))}
            planCount={game.data.plans.length}
            accent={game.data.accent}
            eager={i < 3}
          />
        ))}
      </div>

      <!-- Bot hosting has been "coming" in the old site's ticker since July with
           no card, no price and no link. One sentence beats seven weeks of that. -->
      <p class="small text-fog mt-8">
        Running a Discord bot or a Node.js app instead? Application hosting is{" "}
        {price(botHosting.monthly)} a month.
        <a href={botUrl} class="text-paper underline underline-offset-4 hover:text-red">Order one</a>.
      </p>
    </div>
  </section>

  <Included />

  <!-- The globe's red markers are the only red in this viewport, which is what
       keeps four of them inside the two-per-viewport rule. The scrubbing points
       are paper so they add none. Don't add a CTA here. -->
  <section class="section band lit lit-br border-t border-[var(--edge)]">
    <div class="shell grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="title">Where your server actually runs.</h2>
        <p class="lead text-fog mt-6 max-w-md">
          Four regions across the country, so your players connect to the one
          nearest them instead of the one that was convenient for us.
        </p>

        <!-- Both lists exist as text so a browser with no WebGL still gets the
             whole picture. Same source as the globe, src/lib/locations.ts. -->
        <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 max-w-sm">
          {HOSTING.map((l) => (
            <li>
              <p class="instrument text-slate">{l.region}</p>
              <p class="mt-1 font-medium">{l.city}</p>
            </li>
          ))}
        </ul>

        <p class="instrument text-slate mt-12">Scrubbed before it reaches you</p>
        <p class="small text-fog mt-3 max-w-md">
          Attack traffic gets pulled off to one of these points and dropped
          there, not at your server. The white points are where that happens.
        </p>
        <ul class="small mt-4 flex flex-wrap gap-x-4 gap-y-1.5 max-w-md">
          {MITIGATION.map((l) => (
            <li class="text-paper">{l.city}</li>
          ))}
        </ul>

        <div class="mt-12">
          <PingTest />
        </div>
      </div>

      <Globe class="lg:ml-auto" />
    </div>
  </section>

  <Faq />
</Layout>
