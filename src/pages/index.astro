---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import GameTile from "../components/GameTile.astro";
import LightRays from "../components/LightRays.astro";
import HeroArt from "../components/HeroArt.astro";
import Faq from "../components/Faq.astro";
import Included from "../components/Included.astro";
import PingTest from "../components/PingTest.astro";
import Globe from "../components/Globe.astro";
import { price } from "../lib/order";
import { HOSTING, MITIGATION } from "../lib/locations";
import { trust } from "../config";
import BotLine from "../components/BotLine.astro";

const games = (await getCollection("games"))
  .filter((g) => g.data.status === "live")
  .sort((a, b) => a.data.shortLabel.localeCompare(b.data.shortLabel));

const cheapest = Math.min(
  ...games.flatMap((g) => g.data.plans.map((p) => p.pricing.monthly))
);
---

<Layout
  title="Game Server Hosting"
  description={`FiveM, Minecraft, Palworld and BeamMP servers from ${price(cheapest)} a month. Three US regions, DDoS protected, online in minutes.`}
>
  <!-- one job: get someone into a cart. no positioning copy up here -->
  <section class="section relative overflow-hidden">
    <!-- order matters: art, light, copy. DOM order is the stack -->
    <HeroArt
      games={games.map((g) => ({ slug: g.data.slug, image: g.data.image, accent: g.data.accent }))}
    />
    <LightRays />

    <div class="shell relative">
      <p class="instrument text-fog">Game servers · Three US regions</p>
      <!-- proof line. the score goes above the fold like every competitor, but
           the stronger signal is a named community that runs on us, so it sits
           right beside it -->
      <div class="small mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-fog">
        {trust.score !== null && (
          <Fragment>
            <a href={trust.url} rel="noopener" class="inline-flex items-center gap-2 hover:text-paper">
              <span class="text-paper" aria-hidden="true">★</span>
              <span><span class="text-paper font-medium">{trust.score.toFixed(1)}</span> on Trustpilot</span>
            </a>
            <span class="text-slate" aria-hidden="true">·</span>
          </Fragment>
        )}
        <a href="/partners" class="hover:text-paper">We run <span class="text-paper font-medium">Natural Light Enhanced</span></a>
      </div>

      <h1 class="display-xl mt-6 max-w-3xl">Order your game server<span class="text-red">.</span></h1>

      <p class="lead text-fog mt-6 max-w-lg">
        Pick your game, pick a size, and it's online in minutes. Plans start at {price(cheapest)} a month.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="#pick"
          class="chamfer inline-flex items-center gap-2 bg-red px-7 py-4 font-medium text-ink transition-colors duration-150 hover:bg-red-pressed"
        >
          Order now
          <span aria-hidden="true">&rarr;</span>
        </a>
        <!-- code is in the promo bar, saying it twice looked nervous -->
        <p class="small text-fog">No setup fee. Cancel anytime.</p>
      </div>
    </div>
  </section>

  <section id="pick" class="section border-t border-[var(--edge)] pt-12 lg:pt-16">
    <div class="shell">
      <h2 class="title">Pick your game</h2>

      <!-- gutter is one cell, this row is what the trail registers to -->
      <div
        data-grid-anchor
        class="mt-8 grid gap-[var(--grid-cell)] sm:grid-cols-2 lg:grid-cols-3"
      >
        {games.map((game, i) => (
          <GameTile
            slug={game.data.slug}
            name={game.data.shortLabel}
            tagline={game.data.tagline}
            image={game.data.image}
            from={Math.min(...game.data.plans.map((p) => p.pricing.monthly))}
            planCount={game.data.plans.length}
            accent={game.data.accent}
            logo={game.data.logo}
            eager={i < 3}
          />
        ))}
      </div>

      <!-- bot hosting was "coming" in the old ticker since july. it's a line
           and a link now -->
      <BotLine class="mt-8" />
    </div>
  </section>

  <Included />

  <!-- globe markers are the only red in this viewport -->
  <section class="section band border-t border-[var(--edge)]">
    <div class="shell grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="title">Where your server actually runs<span class="text-red">.</span></h2>
        <p class="lead text-fog mt-6 max-w-md">
          Three regions across the country, so your players connect to the one
          nearest them instead of the one that was convenient for us.
        </p>

        <!-- both lists as text so no-webgl still gets them -->
        <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-5 max-w-sm">
          {HOSTING.map((l) => (
            <li>
              <p class="instrument text-slate">{l.region}</p>
              <p class="mt-1 font-medium">
                {l.city}
                {l.soldOut && <span class="instrument text-red ml-2">sold out</span>}
              </p>
            </li>
          ))}
        </ul>

        <p class="instrument text-slate mt-12">Scrubbed before it reaches you</p>
        <p class="small text-fog mt-3 max-w-md">
          Attack traffic gets pulled off to one of these points and dropped
          there, not at your server. The white points are where that happens.
        </p>
        <ul class="small mt-4 flex flex-wrap gap-x-4 gap-y-1.5 max-w-md">
          {MITIGATION.map((l) => (
            <li class="text-paper">{l.city}</li>
          ))}
        </ul>

        <div class="mt-12">
          <PingTest />
        </div>
      </div>

      <Globe class="lg:ml-auto" />
    </div>
  </section>

  <Faq />
</Layout>
