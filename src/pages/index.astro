---
import Layout from "../layouts/Layout.astro";
import Terminal from "../components/terminal/Terminal.astro";
import TypingAnimation from "../components/terminal/TypingAnimation.astro";
import AnimatedSpan from "../components/terminal/AnimatedSpan.astro";

// Placeholder numbers until the content directory is wired up. The real board
// reads live occupancy, and it has to be allowed to say something unflattering.
const regions = [
  { code: "MIA", city: "Miami, FL", ping: 4, open: 9, total: 48 },
  { code: "IAD", city: "Ashburn, VA", ping: 11, open: 5, total: 48 },
];

const open = regions.reduce((n, r) => n + r.open, 0);
const total = regions.reduce((n, r) => n + r.total, 0);
---

<Layout title="Lumix Solutions">
  <section class="section">
    <div class="shell">
      <p class="instrument text-fog">
        {open} of {total} slots open
        {regions.map((r) => <span class="ml-3">· {r.code} {r.ping}ms</span>)}
      </p>

      <h1 class="display-xl mt-8 max-w-4xl">
        We cap our own servers.<br />That's the whole pitch.
      </h1>

      <p class="lead text-fog mt-8 max-w-xl">
        Most hosts sell a node until it buckles. We stop at a number, publish it, and
        let you watch it move. Miami and Ashburn, and nothing between you and the box.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <!-- Ink on red, not white. Paper on red is 3.02:1 and fails AA. Looks wrong
             for about a minute, then it doesn't. -->
        <a
          href="/games"
          class="chamfer inline-flex items-center bg-red px-6 py-3 font-medium text-ink transition-colors duration-150 hover:bg-red-pressed"
        >
          See what's open
        </a>
        <a href="/status" class="text-fog underline-offset-4 hover:text-paper hover:underline">
          Live status
        </a>
      </div>
    </div>
  </section>

  <section class="section border-t border-[var(--edge)]">
    <div class="shell grid gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="instrument text-fog">What you actually see</p>
        <h2 class="display-l mt-6">Your console, not a dashboard about your console.</h2>
        <p class="text-fog mt-6 max-w-md">
          Full output, full file access, and a restart that takes eleven seconds. The same
          panel our own engineers use when they're the ones on call.
        </p>
      </div>

      <Terminal label="MIA-04 · fivem" class="lg:justify-self-end">
        <TypingAnimation>./run.sh +exec server.cfg</TypingAnimation>
        <AnimatedSpan class="text-fog">Loading resources from /txData/CFXDefault</AnimatedSpan>
        <AnimatedSpan class="text-fog">Started 214 resources in 3.4s</AnimatedSpan>
        <AnimatedSpan class="text-fog">Authenticating with Cfx.re...</AnimatedSpan>
        <AnimatedSpan>Server listening on 51.81.44.12:30120</AnimatedSpan>
        <AnimatedSpan>Slots 0/64 · tick 0.31ms · uptime 00:00:11</AnimatedSpan>
      </Terminal>
    </div>
  </section>

  <section class="section border-t border-[var(--edge)]">
    <div class="shell grid gap-4 sm:grid-cols-2 lg:max-w-3xl">
      {regions.map((region) => (
        <div class="chamfer border border-[var(--edge)] bg-ink-soft p-6">
          <p class="instrument text-fog">{region.code}</p>
          <p class="title mt-3">{region.city}</p>
          <p class="small text-fog mt-2 tabular">
            {region.ping}ms median · {region.open} of {region.total} slots open
          </p>
        </div>
      ))}
    </div>
  </section>
</Layout>
