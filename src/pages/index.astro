---
import Layout from "../layouts/Layout.astro";
import { liveCategories } from "../data/catalog";
import { spotlight } from "../data/site";
import { siteConfig, stats } from "../data/site";
---

<Layout title="Game Server & VPS Hosting">

  {spotlight.enabled && (
    <div>
    <div>
    
      <div>
        <span>
          <span></span>
          <span></span>
        </span>
        <span>// BROADCAST:</span>
        <p>
          Featured monthly spotlight: <span>{spotlight.name}</span>
        </p>
      </div>

      <a 
        href="/spotlight"
      >
        <span>Read more</span>
        <span>&rarr;</span>
      </a>

    </div>
  </div>
  )}

  <!-- Hero Section -->
  <section>
    <!-- Grid Background -->
    <div></div>
    
    <div>
      <div>
        <!-- Left: Content -->
        <div>
          <div>
            <span>[</span> LUMIX_SOLUTIONS <span>]</span> // infrastructure
          </div>
          
          <h1>
            Infrastructure built<br/>
            <span>by engineers</span>
          </h1>
          
          <p>
            Reliable compute, game server hosting, voice infrastructure, and 
            enterprise-grade DDoS protection. No buzzwords, just infrastructure 
            that works.
          </p>
          
          <div>
            <a href="/games">
              Build Your Server
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
            <a href="/games#catalog">
              Browse Games
            </a>
          </div>
        </div>
        
        <!-- Right: Terminal -->
        <div>
        </div>
      </div>
    </div>
  </section>
  
  <div></div>
  
  <!-- Stats Section -->
  <section>
    <div>
      <div>
        {stats.map((stat, index) => (
          <div data-animate>
            <div>
              {stat.value}
              <span>{stat.unit}</span>
            </div>
            <div>{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <div></div>

  <!-- Featured Games -->
  <section>
    <div>
      <div>
        <div>
          <span>// BUILD_YOUR_SERVER</span>
          <h2>Pick a game, size it, deploy</h2>
          <p>
            Configure everything here. Your plan, location, and billing cycle carry
            straight into checkout with nothing to re-select.
          </p>
        </div>
        <a href="/games">
          View Full Catalog
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div>
        {liveCategories.map(category => (
          <a href={`/games/${category.slug}`}>{category.shortLabel}</a>
        ))}
      </div>
    </div>
  </section>

  <div></div>

  <!-- What We Do Section -->
  <section>
    <div>
      <div>
        <!-- Left: Text -->
        <div>
          <span>// OVERVIEW</span>
          <h2>
            What we do
          </h2>
          <div>
            <p>
              Lumix Solutions provides infrastructure services for businesses and 
              developers who need reliability without the corporate overhead.
            </p>
            <p>
              We specialize in <span>Node.js application hosting</span>, 
              <span>game server infrastructure</span>, 
              <span>voice communication servers</span>, and 
              <span>DDoS mitigation</span>.
            </p>
            <p>
              Our team comes from backgrounds in systems administration, network 
              engineering, and software development. We build what we'd want to use.
            </p>
          </div>
          
          <div>
            <div>SUPPORTED PLATFORMS</div>
            <div>
              {['Node.js', 'Python', 'Docker', 'TeamSpeak', 'Mumble', 'Game Servers'].map(platform => (
                <span>
                  {platform}
                </span>
              ))}
            </div>
          </div>
        </div>
        
        <!-- Right: Terminal -->
        <div>
        </div>
      </div>
    </div>
  </section>
  
  <div></div>

  <!-- CTA Section -->
  <section>
    <div>
      <div>
        <!-- Background grid -->
        <div></div>
        
        <div>
          <div>
            $ deploy --production
          </div>
          <h2>
            Ready to deploy?
          </h2>
          <p>
            Access our billing portal to configure your infrastructure. 
            Hourly billing, no long-term contracts, cancel anytime.
          </p>
          <div>
            <a href={siteConfig.links.billing} target="_blank" rel="noopener noreferrer">
              Access Billing Portal
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
            <a href="/contact">
              Contact Sales
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
