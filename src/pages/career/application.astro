---
import Layout from "../../layouts/Layout.astro";
---

<Layout
    title="Apply - Careers"
    description="Apply to join the Lumix Solutions team. Submit your application for IT, Public Relations, or R&D positions."
>
    <!-- Page Header -->
    <section>
        <div>
            <div>
                <span
                >
                    <span>$</span> lumix apply --start
                </span>
                <h1
                >
                    Submit your <span>application</span>
                </h1>
                <p
                >
                    Tell us about yourself. We review every application and will
                    get back to you within a few business days.
                </p>
            </div>
        </div>
    </section>

    <!-- Application Form -->
    <section>
        <div>
            <div>
                <!-- Left: Form -->
                <div>
                    <span
                        >// APPLICATION_FORM</span
                    >
                    
                    <!-- Success Message (hidden by default) -->
                    <div id="success-message">
                        <div>
                            <div>
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <h3>Application Submitted!</h3>
                            <p>
                                Thanks for applying to Lumix Solutions. We'll review your application and get back to you within a few business days.
                            </p>
                            <a href="/career">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                                </svg>
                                Back to Careers
                            </a>
                        </div>
                    </div>
                    
                    <form
                        action="https://formspree.io/f/xjgebaal"
                        method="POST"
                        id="application-form"
                    >
                        <!-- Hidden field for form identification -->
                        <input
                            type="hidden"
                            name="_subject"
                            value="New Job Application - Lumix Solutions"
                        />

                        <!-- Personal Information -->
                        <div>
                            <h3
                            >
                                <span>01</span>
                                Personal Information
                            </h3>

                            <div>
                                <div>
                                    <label
                                        for="firstName"
                                        >First Name *</label
                                    >
                                    <input
                                        type="text"
                                        id="firstName"
                                        name="firstName"
                                        required
                                        placeholder="John"
                                    />
                                </div>
                                <div>
                                    <label
                                        for="lastName"
                                        >Last Name *</label
                                    >
                                    <input
                                        type="text"
                                        id="lastName"
                                        name="lastName"
                                        required
                                        placeholder="Doe"
                                    />
                                </div>
                            </div>

                            <div>
                                <label
                                    for="email"
                                    >Email Address *</label
                                >
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    placeholder="john@example.com"
                                />
                            </div>

                            <div>
                                <label
                                    for="discord"
                                    >Discord Username</label
                                >
                                <input
                                    type="text"
                                    id="discord"
                                    name="discord"
                                    placeholder="username#0000 or username"
                                />
                            </div>
                        </div>

                        <!-- Position -->
                        <div>
                            <h3
                            >
                                <span>02</span>
                                Position Details
                            </h3>

                            <div>
                                <label
                                    for="department"
                                    >Department *</label
                                >
                                <select
                                    id="department"
                                    name="department"
                                    required
                                >
                                    <option value=""
                                        >Select a department</option
                                    >
                                    <option value="IT">IT Department</option>
                                    <option value="Public Relations"
                                        >Public Relations</option
                                    >
                                    <option value="R&D"
                                        >Research & Development</option
                                    >
                                </select>
                            </div>

                            <div>
                                <label
                                    for="position"
                                    >Position Applying For *</label
                                >
                                <input
                                    type="text"
                                    id="position"
                                    name="position"
                                    required
                                    placeholder="e.g., Systems Administrator, Community Manager"
                                />
                            </div>

                            <div>
                                <label
                                    for="availability"
                                    >Availability (hours/week) *</label
                                >
                                <select
                                    id="availability"
                                    name="availability"
                                    required
                                >
                                    <option value=""
                                        >Select availability</option
                                    >
                                    <option value="10-20"
                                        >10-20 hours/week</option
                                    >
                                    <option value="20-30"
                                        >20-30 hours/week</option
                                    >
                                    <option value="30-40"
                                        >30-40 hours/week</option
                                    >
                                    <option value="40+"
                                        >40+ hours/week (Full-time)</option
                                    >
                                </select>
                            </div>
                        </div>

                        <!-- Experience -->
                        <div>
                            <h3
                            >
                                <span>03</span>
                                Experience & Skills
                            </h3>

                            <div>
                                <label
                                    for="experience"
                                    >Relevant Experience *</label
                                >
                                <textarea
                                    id="experience"
                                    name="experience"
                                    rows="4"
                                    required
                                    placeholder="Tell us about your relevant experience, previous roles, and accomplishments..."
                                ></textarea>
                            </div>

                            <div>
                                <label
                                    for="skills"
                                    >Key Skills *</label
                                >
                                <textarea
                                    id="skills"
                                    name="skills"
                                    rows="3"
                                    required
                                    placeholder="List your technical skills, tools, languages, certifications..."
                                ></textarea>
                            </div>

                            <div>
                                <label
                                    for="portfolio"
                                    >Portfolio / Links</label
                                >
                                <input
                                    type="text"
                                    id="portfolio"
                                    name="portfolio"
                                    placeholder="GitHub, LinkedIn, personal website, etc."
                                />
                            </div>
                        </div>

                        <!-- Additional -->
                        <div>
                            <h3
                            >
                                <span>04</span>
                                Additional Information
                            </h3>

                            <div>
                                <label
                                    for="whyLumix"
                                    >Why do you want to join Lumix? *</label
                                >
                                <textarea
                                    id="whyLumix"
                                    name="whyLumix"
                                    rows="4"
                                    required
                                    placeholder="What interests you about Lumix Solutions and this role?"
                                ></textarea>
                            </div>

                            <div>
                                <label
                                    for="additionalInfo"
                                    >Anything else we should know?</label
                                >
                                <textarea
                                    id="additionalInfo"
                                    name="additionalInfo"
                                    rows="3"
                                    placeholder="Additional information, questions, or comments..."
                                ></textarea>
                            </div>
                        </div>

                        <!-- Submit -->
                        <div>
                            <button
                                type="submit"
                            >
                                <span>Submit Application</span>
                                <svg
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                                    ></path>
                                </svg>
                            </button>
                            <p>
                                By submitting, you agree to our
                                <a
                                    href="/privacy"
                                    >Privacy Policy</a
                                >. We'll only use your information for
                                recruitment purposes.
                            </p>
                        </div>
                    </form>
                </div>

                <!-- Right: Terminal + Info -->
                <div>

                    <!-- Tips -->
                    <div>
                        <span
                            >// APPLICATION_TIPS</span
                        >
                        <h3>
                            Tips for a strong application
                        </h3>
                        <ul>
                            <li>
                                <span>→</span>
                                <span
                                    >Be specific about your experience and
                                    achievements</span
                                >
                            </li>
                            <li>
                                <span>→</span>
                                <span
                                    >Include links to your work (GitHub,
                                    portfolio, etc.)</span
                                >
                            </li>
                            <li>
                                <span>→</span>
                                <span>Show genuine interest in what we do</span>
                            </li>
                            <li>
                                <span>→</span>
                                <span
                                    >Be honest about your availability and
                                    expectations</span
                                >
                            </li>
                        </ul>
                    </div>

                    <!-- Back link -->
                    <a
                        href="/career"
                    >
                        <svg
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                        </svg>
                        Back to open positions
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>


<script>
    const form = document.getElementById('application-form') as HTMLFormElement;
    const successMessage = document.getElementById('success-message');
    const submitButton = form?.querySelector('button[type="submit"]');
    
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Disable button and show loading state
        if (submitButton) {
            submitButton.setAttribute('disabled', 'true');
            submitButton.innerHTML = `
                <span>Submitting...</span>
                <svg fill="none" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            `;
        }
        
        const formData = new FormData(form);
        
        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            });
            
            if (response.ok) {
                // Hide form, show success message
                form.classList.add('hidden');
                successMessage?.classList.remove('hidden');
                
                // Scroll to top of success message
                successMessage?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
                throw new Error('Form submission failed');
            }
        } catch (error) {
            // Re-enable button on error
            if (submitButton) {
                submitButton.removeAttribute('disabled');
                submitButton.innerHTML = `
                    <span>Submit Application</span>
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                    </svg>
                `;
            }
            alert('There was an error submitting your application. Please try again or email us directly at career@lumixsolutions.org');
        }
    });
</script>
