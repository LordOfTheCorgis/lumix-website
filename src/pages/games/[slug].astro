---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import LightRays from "../../components/LightRays.astro";
import { orderUrl, price } from "../../lib/order";
import { firstTen } from "../../lib/firstTen";
import AfterPurchase from "../../components/AfterPurchase.astro";
import OrderBuilder from "../../components/OrderBuilder.astro";
import { demoPanel, links } from "../../config";
import { HOSTING } from "../../lib/locations";
import { GAME_SEO, FIVEM_FAQ } from "../../lib/seo";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games
    .filter((g) => g.data.status === "live")
    .map((game) => ({ params: { slug: game.data.slug }, props: { game } }));
}

const { game } = Astro.props;
const g = game.data;
const steps = firstTen(g.slug);
const defaultRegion = g.locations ? HOSTING.find((r) => !r.soldOut) : undefined;
// every region flagged soldOut: the order buttons go dead, so the schema says so too
const closed = g.locations && !defaultRegion;

// cheapest first, people scan for the entry price
const plans = [...g.plans].sort((a, b) => a.pricing.monthly - b.pricing.monthly);

// search title and description off the same cheapest plan the page shows, falls
// back to the yaml copy for games without a hand-written entry
const seo = GAME_SEO[g.slug];
const seoTitle = seo?.title ?? g.label;
const seoDescription = seo ? seo.description(price(plans[0].pricing.monthly)) : g.description;
const faq = g.slug === "fivem" ? FIVEM_FAQ : [];
const faqSchema = faq.length && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// Product + an Offer per plan off the same yaml so schema and table can't
// disagree. old site shipped Organization only on a page with a price table
const siteUrl = "https://lumixsolutions.org";
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: g.label,
  description: g.description,
  image: new URL(g.image.src, siteUrl).href,
  brand: { "@type": "Brand", name: "Lumix Solutions" },
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.pricing.monthly.toFixed(2),
    priceCurrency: "USD",
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: plan.pricing.monthly.toFixed(2),
      priceCurrency: "USD",
      billingIncrement: 1,
      unitCode: "MON",
    },
    availability: closed ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
    url: orderUrl(plan.pid, "monthly", defaultRegion?.whmcsId),
  })),
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={g.image.src}
  imageAlt={`${g.label} on Lumix Solutions`}
  breadcrumbs={[{ name: "Game Hosting", path: "/games/" }, { name: g.label, path: `/games/${g.slug}/` }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- same light as the home hero but always this game's accent. accent is
       the beam and the eyebrow mark, red stays on the CTA -->
  <section
    data-hero
    class="relative overflow-hidden border-b border-[var(--edge)]"
    style={`--game-accent:${g.accent}`}
  >
    <Image
      src={g.image}
      alt=""
      widths={[800, 1600]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover opacity-60 [object-position:68%_45%]"
      loading="eager"
    />
    <!-- ink shelf under the copy, art on the right -->
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/70 to-ink/15" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink to-transparent" aria-hidden="true"></div>
    <!-- the header sits on this now, keep the nav readable over bright art -->
    <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-ink/75 to-transparent" aria-hidden="true"></div>
    <LightRays seed={11} count={7} />

    <div class="shell relative pb-16 pt-36 lg:pb-24 lg:pt-44">
      <p class="instrument flex items-center gap-3 text-fog">
        <span class="inline-block h-2 w-2" style={`background:${g.accent}`} aria-hidden="true"></span>
        <a href="/games/" class="hover:text-paper">All games</a>
        <span aria-hidden="true">·</span>
        <span class="text-paper">{g.shortLabel}</span>
      </p>
      <h1 class="display-l mt-6 max-w-2xl">{g.label}</h1>
      <p class="lead text-fog mt-5 max-w-xl">{g.tagline}</p>

      {g.highlights && (
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {g.highlights.map((item) => (
            <li class="small text-fog">{item}</li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="section band">
    <div class="shell">
      <h2 class="title">Build your order</h2>
      <p class="small text-fog mt-3 max-w-lg">
        Longer terms cost less per month and you pay for the whole term up
        front at checkout.
      </p>

      <OrderBuilder plans={plans} hasLocations={g.locations} />

      <p class="small text-fog mt-10 max-w-xl">{g.description}</p>
      <!-- no trial, refunds case by case, matches terms.md -->
      <p class="small text-slate mt-4 max-w-xl">
        No free trial. Refunds are handled case by case, not on a fixed window.
      </p>
    </div>
  </section>

  <!-- the three beats a buyer wants confirmed, right under the plans -->
  <AfterPurchase />

  <!-- the detailed panel walkthrough. steps from the docs, src/lib/firstTen.ts -->
  <section class="section border-t border-[var(--edge)]">
    <div class="shell grid gap-12 lg:grid-cols-[calc(10*var(--grid-cell))_minmax(0,1fr)] lg:gap-[var(--grid-cell)]">
      <div>
        <h2 class="display-l">Your first ten minutes<span class="text-red">.</span></h2>
        <p class="lead text-fog mt-6 max-w-md">
          Provisioning is automatic and the panel login is emailed the moment
          checkout completes. Here's the order things happen in.
        </p>

        {demoPanel.url ? (
          <div class="mt-10">
            <a
              href={demoPanel.url}
              rel="noopener"
              class="chamfer inline-flex items-center gap-2 border border-[var(--edge-strong)] px-7 py-4 font-medium text-paper transition-colors duration-150 hover:border-red hover:text-red"
            >
              Look around the panel first
              <span aria-hidden="true">&rarr;</span>
            </a>
            {demoPanel.user && (
              <p class="small text-slate mt-3">
                Read-only demo. Sign in with <span class="text-fog">{demoPanel.user}</span>
                {demoPanel.password && <> / <span class="text-fog">{demoPanel.password}</span></>}.
              </p>
            )}
          </div>
        ) : (
          <p class="small text-slate mt-10 max-w-md">
            Want to see the panel before you pay? The docs have every screen:{" "}
            <a href={`${links.docs}/lumi-panel/overview`} rel="noopener" class="text-fog underline underline-offset-4 hover:text-paper">Lumi-Panel overview</a>.
          </p>
        )}
      </div>

      <ol data-grid-anchor class="m-0 list-none p-0">
        {steps.map((step, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-[var(--edge)] py-6 first:border-t-0 first:pt-0">
            <span class="instrument tabular pt-1" style={`color:${g.accent}`}>{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-paper font-medium">{step.title}</h3>
              <p class="small text-fog mt-2 max-w-prose">{step.body}</p>
              {step.href && (
                <a
                  href={step.href}
                  rel={step.href.startsWith("http") ? "noopener" : undefined}
                  class="small mt-2 inline-flex items-center gap-1.5 text-slate hover:text-paper"
                >
                  {step.href.startsWith("/tools") ? "Open the generator" : "Read the docs"}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {faq.length > 0 && (
    <section class="section border-t border-[var(--edge)]">
      <div class="shell grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
        <div>
          <h2 class="title">{g.shortLabel} Hosting Questions<span class="text-red">.</span></h2>
          <p class="lead text-fog mt-6 max-w-sm">
            What people ask before they pick a plan.
          </p>
          <p class="small text-fog mt-6 max-w-sm">
            Sizing a server?{" "}
            <a href="/guides/fivem-server-requirements/" class="text-paper underline underline-offset-4">How much RAM and CPU a FiveM server needs</a>.
            Building a config?{" "}
            <a href="/tools/fivem-server-cfg/" class="text-paper underline underline-offset-4">Free server.cfg generator</a>.
          </p>
        </div>
        <div class="border-t border-[var(--edge)]">
          {faq.map((f) => (
            <details class="group border-b border-[var(--edge)] py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-paper font-medium">
                {f.q}
                <span aria-hidden="true" class="text-slate transition-transform duration-150 group-open:rotate-45">+</span>
              </summary>
              <p class="small text-fog mt-3 max-w-prose">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
