---
import Layout from "../../layouts/Layout.astro";
import { liveCategories, startingPrice, type GameCategory } from "../../data/catalog";
import { formatPrice } from "../../lib/whmcs";
import { siteConfig } from "../../data/site";

// Only orderable categories get a builder page. Coming-soon entries stay on
// /games as catalog cards until they have a WHMCS product behind them.
export function getStaticPaths() {
  return liveCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

interface Props {
  category: GameCategory;
}

const { category } = Astro.props;
const from = startingPrice(category);
---

<Layout title={category.label} description={category.description}>
  <!-- Hero -->
  <section>
    <div></div>

    <div>
      <nav aria-label="Breadcrumb">
        <a href="/games">games</a>
        <span> / </span>
        <span>{category.slug}</span>
      </nav>

      <div>
        <div>
          <h1>{category.label}</h1>
          <p>{category.description}</p>

          {
            category.highlights && (
              <ul>
                {category.highlights.map((highlight) => (
                  <li>
                    <span />
                    {highlight}
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        {
          from !== null && (
            <div>
              <div>
                Starting at
              </div>
              <div>
                {formatPrice(from)}
                <span>/mo</span>
              </div>
              <div>
                {category.plans.length} {category.plans.length === 1 ? "plan" : "plans"} available
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Builder -->
  <section>
    <div>
      <!-- TODO(redesign): rebuild builder UI. Order logic intact in src/lib/whmcs.ts -->
    </div>
  </section>

  <div></div>

  <!-- Reassurance -->
  <section>
    <div>
      <div>
        <div>
          <span>// WHAT_YOU_GET</span>
          <h2>Every plan, no upsell</h2>

          <div>
            <div>
              <div>
                <span>01</span>
              </div>
              <div>
                <h3>Dedicated resources</h3>
                <p>
                  The vCores and RAM on the card are yours. We cap stock per node rather
                  than overselling capacity we do not have.
                </p>
              </div>
            </div>

            <div>
              <div>
                <span>02</span>
              </div>
              <div>
                <h3>DDoS protection included</h3>
                <p>
                  Layer 3/4/7 mitigation on every plan at no extra cost.
                </p>
              </div>
            </div>

            <div>
              <div>
                <span>03</span>
              </div>
              <div>
                <h3>Full panel access</h3>
                <p>
                  Console, file manager, scheduled tasks, and backups from
                  <a
                    href={siteConfig.links.panel}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    panel.lumixsolutions.org
                  </a>.
                </p>
              </div>
            </div>

            <div>
              <div>
                <span>04</span>
              </div>
              <div>
                <h3>Cancel anytime</h3>
                <p>
                  No contracts and no cancellation fee. Longer terms are a discount, not a lock-in.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div>
            <div>
              <span></span>
              <span></span>
              <span></span>
              <span>provision.log</span>
            </div>
            <div>
              <div><span>$</span> lumix provision --game {category.slug}</div>
              <div>Reserving node capacity...</div>
              <div>✓ Node allocated</div>
              <div>✓ DDoS filtering attached</div>
              <div>✓ Panel account created</div>
              <div>✓ Backups scheduled</div>
              <div>&nbsp;</div>
              <div>Server online. Average setup: under 60s.</div>
              <div><span>$</span><span></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div></div>

  <!-- Cross-sell -->
  <section>
    <div>
      <div>
        <div>
          <h2>Hosting something else?</h2>
          <p>
            Browse the full catalog, including the titles we are bringing online next.
          </p>
        </div>
        <a href="/games">
          View all games
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
