---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import LightRays from "../../components/LightRays.astro";
import { orderUrl, price } from "../../lib/order";
import { firstTen } from "../../lib/firstTen";
import { promo, demoPanel, links } from "../../config";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games
    .filter((g) => g.data.status === "live")
    .map((game) => ({ params: { slug: game.data.slug }, props: { game } }));
}

const { game } = Astro.props;
const g = game.data;
const steps = firstTen(g.slug);

// Cheapest first. Seven rows of ascending specs is the shape people actually
// scan; sorting any other way makes them hunt for the entry price.
const plans = [...g.plans].sort((a, b) => a.pricing.monthly - b.pricing.monthly);

// Product + one Offer per plan, built off the same yaml the page renders, so
// the structured data can't say a different price than the table. The
// marketing log flagged the old site for shipping only Organization schema
// on pages with a visible $8.99 and a full spec table; six weeks unfixed there.
const siteUrl = "https://lumixsolutions.org";
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: g.label,
  description: g.description,
  image: new URL(g.image.src, siteUrl).href,
  brand: { "@type": "Brand", name: "Lumix Solutions" },
  offers: plans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.pricing.monthly.toFixed(2),
    priceCurrency: "USD",
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: plan.pricing.monthly.toFixed(2),
      priceCurrency: "USD",
      billingIncrement: 1,
      unitCode: "MON",
    },
    availability: "https://schema.org/InStock",
    url: orderUrl(plan.pid),
  })),
};
---

<Layout title={g.label} description={g.description}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <!-- The colour story pays off here. The home hero picks a game at random and
       lights it in that game's accent; this page is that game, so the same
       light lands in its own colour every time. Accent is the beam and the
       eyebrow mark. Red stays on the CTA and the popular plan. -->
  <section
    class="relative overflow-hidden border-b border-[var(--edge)]"
    style={`--game-accent:${g.accent}`}
  >
    <Image
      src={g.image}
      alt=""
      widths={[800, 1600]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover opacity-60 [object-position:68%_45%]"
      loading="eager"
    />
    <!-- Same idea as the home hero: an ink shelf under the copy on the left,
         the art allowed to be itself on the right. -->
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/70 to-ink/15" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-ink to-transparent" aria-hidden="true"></div>
    <LightRays seed={11} count={7} />

    <div class="shell relative py-16 lg:py-24">
      <p class="instrument flex items-center gap-3 text-fog">
        <span class="inline-block h-2 w-2" style={`background:${g.accent}`} aria-hidden="true"></span>
        <a href="/games" class="hover:text-paper">All games</a>
        <span aria-hidden="true">·</span>
        <span class="text-paper">{g.shortLabel}</span>
      </p>
      <h1 class="display-l mt-6 max-w-2xl">{g.label}</h1>
      <p class="lead text-fog mt-5 max-w-xl">{g.tagline}</p>

      {g.highlights && (
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {g.highlights.map((item) => (
            <li class="small text-fog">{item}</li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="section band">
    <div class="shell">
      <h2 class="title">Choose a size</h2>
      <p class="small text-fog mt-3 max-w-lg">
        You pick the region on the next screen: Salt Lake City, Dallas, Ashburn
        or Miami. Billed monthly unless you choose a longer term at checkout.
        {promo.live && (
          <>
            {" "}Code <span class="instrument text-paper">{promo.code}</span> takes{" "}
            {promo.percent}% off.
          </>
        )}
      </p>

      <ul class="mt-8 space-y-3">
        {plans.map((plan) => (
          <li
            class:list={[
              "chamfer border bg-ink-soft p-6",
              plan.popular ? "border-red" : "border-[var(--edge)]",
            ]}
          >
            <div class="flex flex-col gap-6 lg:flex-row lg:items-center">
              <div class="lg:w-56 lg:shrink-0">
                {plan.popular && <p class="instrument text-red">Most popular</p>}
                <h3 class:list={["title", plan.popular && "mt-2"]}>{plan.name}</h3>
              </div>

              <dl class="grid flex-1 grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4">
                <div>
                  <dt class="instrument text-slate">vCores</dt>
                  <dd class="small tabular mt-1">{plan.specs.vcores}</dd>
                </div>
                <div>
                  <dt class="instrument text-slate">Memory</dt>
                  <dd class="small tabular mt-1">{plan.specs.ramGb} GB</dd>
                </div>
                <div>
                  <dt class="instrument text-slate">NVMe</dt>
                  <dd class="small tabular mt-1">{plan.specs.storageGb} GB</dd>
                </div>
                <div>
                  <dt class="instrument text-slate">Slots</dt>
                  <dd class="small mt-1">{plan.specs.slots}</dd>
                </div>
              </dl>

              <div class="flex items-center gap-6 lg:shrink-0">
                <p class="tabular">
                  <span class="title price">{price(plan.pricing.monthly)}</span>
                  <span class="small text-fog">/mo</span>
                </p>

                <!-- Only the popular plan is filled red. Seven red buttons would
                     be seven equally loud choices, which is no choice at all. -->
                <a
                  href={orderUrl(plan.pid)}
                  class:list={[
                    "chamfer inline-flex items-center px-6 py-3 font-medium transition-colors duration-150",
                    plan.popular
                      ? "bg-red text-ink hover:bg-red-pressed"
                      : "border border-[var(--edge-strong)] text-paper hover:border-red hover:text-red",
                  ]}
                >
                  Order
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <p class="small text-fog mt-10 max-w-xl">{g.description}</p>
      <!-- Straight answers to the two questions the marketing log kept asking
           on our behalf. No trial, refunds case by case; matches terms.md. -->
      <p class="small text-slate mt-4 max-w-xl">
        No free trial. Refunds are handled case by case, not on a fixed window.
      </p>
    </div>
  </section>

  <!-- What happens after you pay. The thing that stops people isn't the
       price, it's not knowing what they'll be looking at afterwards. Steps
       come from the docs, see src/lib/firstTen.ts. -->
  <section class="section border-t border-[var(--edge)]">
    <div class="shell grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
      <div>
        <p class="instrument text-fog">After checkout</p>
        <h2 class="display-l mt-4">Your first ten minutes<span class="text-red">.</span></h2>
        <p class="lead text-fog mt-6 max-w-md">
          Provisioning is automatic and the panel login is emailed the moment
          checkout completes. Here's the order things happen in.
        </p>

        {demoPanel.url ? (
          <div class="mt-10">
            <a
              href={demoPanel.url}
              rel="noopener"
              class="chamfer inline-flex items-center gap-2 border border-[var(--edge-strong)] px-7 py-4 font-medium text-paper transition-colors duration-150 hover:border-red hover:text-red"
            >
              Look around the panel first
              <span aria-hidden="true">&rarr;</span>
            </a>
            {demoPanel.user && (
              <p class="small text-slate mt-3">
                Read-only demo. Sign in with <span class="text-fog">{demoPanel.user}</span>
                {demoPanel.password && <> / <span class="text-fog">{demoPanel.password}</span></>}.
              </p>
            )}
          </div>
        ) : (
          <p class="small text-slate mt-10 max-w-md">
            Want to see the panel before you pay? The docs have every screen:{" "}
            <a href={`${links.docs}/lumi-panel/overview`} rel="noopener" class="text-fog underline underline-offset-4 hover:text-paper">Lumi-Panel overview</a>.
          </p>
        )}
      </div>

      <ol class="m-0 list-none p-0">
        {steps.map((step, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-[var(--edge)] py-6 first:border-t-0 first:pt-0">
            <span class="instrument tabular pt-1" style={`color:${g.accent}`}>{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="text-paper font-medium">{step.title}</h3>
              <p class="small text-fog mt-2 max-w-prose">{step.body}</p>
              {step.href && (
                <a
                  href={step.href}
                  rel={step.href.startsWith("http") ? "noopener" : undefined}
                  class="small mt-2 inline-flex items-center gap-1.5 text-slate hover:text-paper"
                >
                  {step.href.startsWith("/tools") ? "Open the generator" : "Read the docs"}
                  <span aria-hidden="true">&rarr;</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
