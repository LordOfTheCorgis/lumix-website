---
import Layout from "../layouts/Layout.astro";
import SpotlightContent from "../components/SpotlightContent.astro";
import { spotlight, siteConfig } from "../data/site";

// Flip spotlight.enabled in src/data/site.ts when there's no server to feature.
// Page stays at /spotlight either way so old links don't 404, it just goes
// noindex and shows the placeholder below.
const isLive = spotlight.enabled !== false;

const liveDescription =
    "Each month, Lumix Solutions highlights a notable community-led server that demonstrates innovation, creativity, and dedication. These spotlights showcase the best of what the community has to offer and celebrate the hard work and dedication of server owners and developers.";
const offDescription =
    "No community server is being featured right now. Check back soon or tell us about a server worth highlighting.";
---

<Layout
    title="Spotlight"
    description={isLive ? liveDescription : offDescription}
    noindex={!isLive}
>
    {isLive ? (
        <SpotlightContent />
    ) : (
        <div class="relative">
            <div class="absolute inset-0 grid-overlay opacity-20 pointer-events-none z-0"></div>

            <section class="py-24 lg:py-36 relative z-10">
                <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                    <span class="text-mono text-xs text-lumix-gray mb-8 block animate-fade-in">
                        // SPOTLIGHT_STATUS: <span class="text-lumix-red">between features</span>
                    </span>

                    <h1 class="heading-xl text-lumix-white mb-6 animate-fade-in-up">
                        No server in the<br />
                        <span class="text-lumix-red">spotlight right now</span>
                    </h1>

                    <p class="body-lg text-lumix-gray mb-10 animate-fade-in-up animate-delay-100">
                        We feature one community-led server at a time and only when it
                        earns it. The next one is still being picked. If you run a server
                        worth showing off, or you know one, send it our way.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-up animate-delay-200">
                        <a
                            href="/contact"
                            class="text-mono text-sm px-6 py-3 bg-lumix-red text-lumix-white border border-lumix-red hover:bg-transparent hover:text-lumix-red transition-colors text-center"
                        >
                            Nominate a server
                        </a>
                        <a
                            href={siteConfig.links.discord}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-mono text-sm px-6 py-3 border border-terminal-border text-lumix-gray hover:text-lumix-white hover:border-lumix-gray-dark transition-colors text-center"
                        >
                            Join the Discord
                        </a>
                    </div>
                </div>
            </section>
        </div>
    )}
</Layout>
