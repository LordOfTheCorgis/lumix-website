---
import Layout from "../layouts/Layout.astro";
import { spotlight, siteConfig } from "../data/site";

// Flip spotlight.enabled in src/data/site.ts when there's no server to feature.
// Page stays at /spotlight either way so old links don't 404, it just goes
// noindex and shows the placeholder below.
const isLive = spotlight.enabled !== false;

const liveDescription =
    "Each month, Lumix Solutions highlights a notable community-led server that demonstrates innovation, creativity, and dedication. These spotlights showcase the best of what the community has to offer and celebrate the hard work and dedication of server owners and developers.";
const offDescription =
    "No community server is being featured right now. Check back soon or tell us about a server worth highlighting.";
---

<Layout
    title="Spotlight"
    description={isLive ? liveDescription : offDescription}
    noindex={!isLive}
>
    {isLive ? (
        <!-- TODO(redesign): rebuild spotlight. Data intact in src/data/site.ts -->
    ) : (
        <div>
            <div></div>

            <section>
                <div>
                    <span>
                        // SPOTLIGHT_STATUS: <span>between features</span>
                    </span>

                    <h1>
                        No server in the<br />
                        <span>spotlight right now</span>
                    </h1>

                    <p>
                        We feature one community-led server at a time and only when it
                        earns it. The next one is still being picked. If you run a server
                        worth showing off, or you know one, send it our way.
                    </p>

                    <div>
                        <a
                            href="/contact"
                        >
                            Nominate a server
                        </a>
                        <a
                            href={siteConfig.links.discord}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Join the Discord
                        </a>
                    </div>
                </div>
            </section>
        </div>
    )}
</Layout>
