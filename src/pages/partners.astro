---
import Layout from "../layouts/Layout.astro";

const partners = [
  {
    name: "Elite Modification",
    founder: "EM Team",
    description: "Elite Modification is back and focused on helping communities level up with premium, practical server assets. Their work is built for immersive gameplay, clean branding, and dependable performance.",
    services: [
      "Livery development",
      "EUP packages",
      "Patches and badges",
      "Server-sided sirens",
      "Custom scripts",
      "Graphics and branding",
      "Website development",
      "Discord bots and automation"
    ],
    offerCode: "LSXEM",
    offerText: "15% off at checkout",
    url: "https://elitemodification.com/",
    discord: "https://discord.gg/tW2Ybp5UDt"
  },
  {
    name: "FG Development Studio",
    founder: "Freedom_Gaming23",
    description: "FG Development Studios is a veteran-run FiveM development studio focused on quality assets at prices server owners can actually afford. Every release is actively maintained and supported after purchase. No abandonware, no upsells.",
    services: [
      "MLOs & Ymaps",
      "Custom Props & 3D Modeling",
      "Vehicle Liveries & EUP Retextures",
      "Custom Patches & Logos",
      "Occasional Server Scripts",
    ],
    hiringNote: "They are currently working towards FiveM today, with development already pointed at next-gen GTARP platforms and the GTA 6 ecosystem.",
    offerCode: "Lumix15FG",
    offerText: "15% off at checkout",
    url: "https://fgdevelopment.tebex.io/",
    discord: "https://discord.gg/SZhU2cFc4Q"
  },
  {
    name: "Kez Modifications",
    founder: "Kez",
    description: "Kez Modifications is focused on delivering high-quality assets for the FiveM community, with a strong emphasis on reliability, professionalism, and long-term trust.",
    services: [
      "EUP commissions",
      "EUP listings",
      "EUP packages",
      "Patches",
      "Custom EUP work",
      "Upcoming EUP models"
    ],
    hiringNote: "Currently accepting EUP commissions and listings. Join the Discord to view current work and connect directly.",
    discord: "https://discord.gg/AMSrHMZRhW"
  },
  {
    name: "Natural Light Enhanced",
    founder: "NLE",
    description: "NLE specializes in creating realistic, performance-friendly graphics mods for FiveM focused on natural lighting. Their mission is to continually improve and refine visuals for everyone to enjoy.",
    services: [
      "High-quality ENB graphics",
      "Custom mod packs",
      "Realistic lighting enhancements",
      "Optimized performance",
      "Constant updates & improvements",
    ],
    url: "https://naturallightenhanced.com/",
    discord: "https://discord.gg/F5rvPwNJc2"
  },
  {
    name: "Marco's Presets",
    founder: "Marco",
    description: "Marco's Presets offers high-quality ENB and Reshade products for FiveM, enhancing visual fidelity and performance while preserving the freedom of custom media configurations. With a focus on reliability and customer satisfaction, they provide tailored solutions to elevate your server's aesthetics.",
    services: [
      "High quality ENB graphics",
      "High quality Reshade products",
    ],
    url: "https://www.patreon.com/cw/marcopresets/shop",
    discord: "https://discord.gg/marco"
  },
  {
    name: "Valerisn Upfitting",
    founder: "Valerisn",
    description: "Focused on creating clean, high quality Non-ELS vehicles for FiveM with realistic designs, optimized builds, and attention to detail, Valerisn's mission is to provide communities with reliable, immersive vehicle assets that enhance gameplay and fit seamlessly into any server.",
    services: [
      "Non-ELS FiveM Vehicles",
      "Optimized Vehicles",
      "Custom Commission Work",
    ],
    discord: "https://discord.gg/esfvwXEzG7"
  },
  {
    name: "Centrix Development Hub",
    founder: "Mike",
    description: "Centrix Development Hub is a versatile FiveM development team offering a wide range of services, including custom vehicle modifications and graphics design. With a focus on quality and client satisfaction, they provide tailored solutions to enhance your server's experience.",
    services: [
      "Custom Leo's Vehicles",
      "Custom GFX for YOUR server",
    ],
    discord: "https://discord.gg/zamxskR2fQ"
  },
];

const openToPartnership = [
  "Infrastructure providers",
  "Network and security platforms",
  "Software vendors",
  "Strategic integrations"
];
---

<Layout title="Partners" description="Organizations and platforms we work alongside to deliver reliable infrastructure and services.">
  <!-- Page Header -->
  <section>
    <div>
      <div>
        <span>
          <span>$</span> cat /partners/status.conf
        </span>
        <h1>
          Partners
        </h1>
        <p>
          Organizations and platforms we work alongside to deliver reliable infrastructure and services.
        </p>
      </div>
    </div>
  </section>
  
  <!-- Terminal Status Block -->
  <section>
    <div>
      <div>
      </div>
    </div>
  </section>
  
  <!-- Partner Grid -->
  <section>
    <div>
      <span>// ACTIVE_PARTNERS</span>
      
      <div>
        {partners.map(partner => (
          <div>
            <div>
              <!-- Partner name -->
              <h3>
                {partner.name}
              </h3>
              
              <!-- Founder -->
              {partner.founder && (
                <p>
                  <span>Founder: {partner.founder}</span>
                </p>
              )}
              
              <!-- Description -->
              <p>
                {partner.description}
              </p>

              {partner.services && partner.services.length > 0 && (
                <div>
                  <p>Services</p>
                  <ul>
                    {partner.services.map(service => (
                      <li>
                        <span></span>
                        <span>{service}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {partner.hiringNote && (
                <p>
                  {partner.hiringNote}
                </p>
              )}

              {partner.offerCode && (
                <div>
                  <p>Offer</p>
                  <p>
                    Use code <span>{partner.offerCode}</span> for {partner.offerText}.
                  </p>
                </div>
              )}
              
              <!-- Links -->
              <div>
                <div>
                  {partner.url && (
                    <a 
                      href={partner.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                      </svg>
                      <span>{new URL(partner.url).hostname}</span>
                    </a>
                  )}
                  
                  {partner.discord && (
                    <a 
                      href={partner.discord}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <svg fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                      </svg>
                      <span>Discord</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  <!-- Divider -->
  <div>
    <div>
      <div></div>
      <span>END_PARTNERS // BEGIN_COLLABORATION</span>
      <div></div>
    </div>
  </div>
  
  <!-- Partnership Inquiries Section -->
  <section>
    <div>
      <div>
        <!-- Left: Info -->
        <div>
          <span>// PARTNERSHIP_INQUIRIES</span>
          <h2>
            Partnership inquiries
          </h2>
          
          <div>
            <p>
              Lumix Solutions partners with platforms, providers, and organizations that share a focus on reliability, security, and long-term infrastructure thinking.
            </p>
            <p>
              We are selective about partnerships and prioritize technical alignment over marketing arrangements.
            </p>
            
            <div>
              <h3>What we're open to</h3>
              <ul>
                {openToPartnership.map(item => (
                  <li>
                    <span></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        
        <!-- Right: Contact Block -->
        <div>
          <div>
            <span>// OPEN_CHANNEL</span>
            <h3>Contact</h3>
            <p>
              To discuss a potential partnership, reach out at:
            </p>
            
            <div>
              <a 
                href="mailto:partners@lumixsolutions.org"
              >
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                partners@lumixsolutions.org
              </a>
              <a 
                href="mailto:contact@lumixsolutions.org"
              >
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
                contact@lumixsolutions.org
              </a>
            </div>
            
            <div>
              <a 
                href="/contact"
              >
                <span>Or visit our contact page</span>
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
