---
// Public uptime and outage history, which the community asked for by name.
// The numbers come from GitHub Actions checking every five minutes from
// outside our network (scripts/status-check.mjs), not from anything we run,
// so this page keeps working when a node doesn't.
//
// The rows render here with names only; the script fills in state, bars and
// percentages from the live file. "Tracking since" is printed on purpose: a
// 100% that's two days old should say it's two days old.
import Layout from "../layouts/Layout.astro";
import { HOSTING, AVAILABILITY_LABEL } from "../lib/locations";
import { statusData, incidentsData, links } from "../config";

const rows = [
  ...HOSTING.map((h) => ({
    id: h.slug!,
    name: h.city,
    note: h.region,
    // No machine yet, nothing to check. Listed so the page matches /regions.
    tracked: h.availability !== "soon",
    off: h.availability === "soon" ? AVAILABILITY_LABEL.soon : null,
  })),
  { id: "panel", name: "Control panel", note: "panel.lumixsolutions.org", tracked: true, off: null },
  { id: "billing", name: "Billing and support", note: "billing.lumixsolutions.org", tracked: true, off: null },
];
const DAYS = 90;
---

<Layout
  title="Status"
  description="Live uptime for every Lumix region, the control panel and billing, with 90 days of history and every outage logged. Checked every five minutes from outside our network."
>
  <section class="section border-b border-[var(--edge)]">
    <div class="shell">
      <p class="instrument text-fog">Status · checked every 5 minutes from outside our network</p>
      <h1 class="display-xl mt-6 max-w-3xl" data-headline>Checking<span class="text-red">.</span></h1>
      <p class="lead text-fog mt-6 max-w-xl" data-sub>
        Reading the latest results.
      </p>
      <!-- Filled when incidents.json has anything not resolved. Accent edge,
           not a red box: the headline already says whether it's down. -->
      <div class="mt-10 max-w-2xl space-y-4" data-active hidden></div>
      <noscript>
        <p class="lead text-fog mt-6 max-w-xl">
          This page needs JavaScript to read the live results. The raw file is
          at <a href={statusData} class="text-paper underline underline-offset-4">status.json</a>.
        </p>
      </noscript>
    </div>
  </section>

  <section class="section" data-status data-url={statusData} data-days={DAYS}>
    <div class="shell">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="title" data-window-title>Last {DAYS} days</h2>
        <p class="instrument text-slate" data-since></p>
      </div>

      <ol class="m-0 mt-8 list-none border-t border-[var(--edge)] p-0">
        {rows.map((r) => (
          <li
            class:list={["border-b border-[var(--edge)] py-6", !r.tracked && "opacity-50"]}
            data-row={r.tracked ? r.id : undefined}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <p>
                <span class="font-medium text-paper">{r.name}</span>
                <span class="small ml-2 text-slate">{r.note}</span>
              </p>
              <p class="small tabular text-fog">
                {r.off ?? <><span data-state>—</span><span class="text-slate" data-pct></span></>}
              </p>
            </div>
            <!-- One bar per day, oldest left. Empty until the data says
                 otherwise; a day with no checks stays the edge colour
                 rather than pretending to be green. -->
            {r.tracked && (
              <div class="bars mt-4" data-bars aria-hidden="true">
                {Array.from({ length: DAYS }, () => <span></span>)}
              </div>
            )}
          </li>
        ))}
      </ol>

      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 small text-slate" aria-hidden="true">
        <span class="inline-flex items-center gap-2"><span class="key ok"></span>Up all day</span>
        <span class="inline-flex items-center gap-2"><span class="key part"></span>Some failed checks</span>
        <span class="inline-flex items-center gap-2"><span class="key bad"></span>Down more than an hour</span>
        <span class="inline-flex items-center gap-2"><span class="key"></span>No data</span>
      </div>
    </div>
  </section>

  <section class="section border-t border-[var(--edge)]" data-incidents-url={incidentsData}>
    <div class="shell grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <h2 class="title">Incident reports</h2>
        <p class="lead text-fog mt-6 max-w-sm">
          What happened and what we did about it, written by us. The log
          below is the machine's version.
        </p>
      </div>
      <ol class="m-0 list-none p-0" data-reports>
        <li class="small text-fog">Reading the reports.</li>
      </ol>
    </div>
  </section>

  <section class="section band border-t border-[var(--edge)]">
    <div class="shell grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div>
        <h2 class="title">Every outage</h2>
        <p class="lead text-fog mt-6 max-w-sm">
          Logged automatically, start to finish, by the same checks that draw
          the bars above. Nothing gets typed in by hand.
        </p>
        <p class="small text-fog mt-6 max-w-sm">
          Something down that this says is up? Tell us in{" "}
          <a href={links.discord} rel="noopener" class="text-paper underline underline-offset-4 hover:text-red">Discord</a>.
        </p>
      </div>
      <ol class="m-0 list-none p-0" data-outages>
        <li class="small text-fog">Reading the log.</li>
      </ol>
    </div>
  </section>
</Layout>

<style>
  /* 90 slots, always full. Evan's call 2026-10-08: days before tracking
     began render green too (see status-page.ts for how that stays honest). */
  .bars {
    display: grid;
    grid-template-columns: repeat(90, minmax(0, 1fr));
    gap: 2px;
    height: 2rem;
  }
  /* :global on the bar spans: the script builds them, so they never get
     Astro's scoping attribute and a plain scoped selector misses them. */
  .bars :global(span),
  .key {
    background: var(--edge);
  }
  .key {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
  }
  /* Red only means real downtime here. On a good day there's none on the
     page apart from the headline stop. */
  .bars :global(.ok), .key.ok { background: var(--color-up); }
  .bars :global(.part), .key.part { background: var(--color-gold); }
  .bars :global(.bad), .key.bad { background: var(--color-red); }

  /* 90 two-pixel-gapped bars don't fit a phone. Show the last 30 there. */
  @media (max-width: 639px) {
    .bars {
      grid-template-columns: repeat(30, minmax(0, 1fr));
    }
    .bars :global(span:nth-last-child(n + 31)) {
      display: none;
    }
  }
</style>

<script>
  import "../scripts/status-page";
</script>
