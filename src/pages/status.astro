---
// status from the visitor's own browser, not a hosted monitor. no uptime
// history on purpose, the old page had a hand-typed 99.99% and that's exactly
// the kind of number DESIGN.md says we don't print.
//
// regions and vms time a refused https connect (see lib/ping.ts). billing,
// panel and docs used to be on here too, evan cut them.
import Layout from "../layouts/Layout.astro";
import { HOSTING } from "../lib/locations";
import { links } from "../config";

const regions = HOSTING.filter((r) => r.pingUrl).map((r) => ({
  name: r.city,
  detail: r.region,
  url: r.pingUrl!,
  vms: r.vms ?? [],
}));

---

<Layout
  title="Status"
  description="Is it us or you? Checks every Lumix region and server from your own browser, right now."
>
  <section class="section border-b border-[var(--edge)]">
    <div class="shell">
      <p class="instrument text-fog">Status · checked from your browser</p>
      <h1 class="display-xl mt-6 max-w-3xl" data-status-headline aria-live="polite">
        Checking everything<span class="text-red">.</span>
      </h1>
      <p class="lead text-fog mt-6 max-w-xl">
        This page doesn't read a dashboard we control. Your browser reaches out
        to each region and server itself, so if something here says down, it's
        down from where you're sitting.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <button
          type="button"
          data-status-recheck
          class="chamfer inline-flex items-center gap-2 bg-red px-7 py-4 font-medium text-ink transition-colors duration-150 hover:bg-red-pressed disabled:opacity-60"
        >
          Check again
        </button>
        <p class="small text-slate" data-status-stamp>Rechecks every minute while this tab is open.</p>
      </div>
    </div>
  </section>

    <section class="section">
      <div class="shell">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="title">Regions</h2>
          <p class="small text-slate">Round trip from your browser to each server.</p>
        </div>
        <ul class="status-list m-0 mt-8 list-none p-0" data-grid-anchor>
          {regions.map((r) => (
            <>
            <li
              class="status-row"
              data-status-row
              data-url={r.url}
              data-name={r.name}
              data-state="checking"
            >
              <div class="min-w-0">
                <p class="font-display text-xl font-semibold tracking-tight">{r.name}</p>
                <p class="small text-fog mt-1">{r.detail}</p>
              </div>
              <p class="tabular text-fog text-right" data-status-ms>
                <span aria-hidden="true">···</span>
              </p>
              <p class="instrument flex items-center justify-end gap-3" data-status-label>
                <span class="tick" aria-hidden="true"></span>
                <span data-status-text>Checking</span>
              </p>
            </li>
            {r.vms.map((vm) => (
              <li
                class="status-row status-vm"
                data-status-row={vm.ip ? "" : undefined}
                data-url={vm.ip ? `https://${vm.ip}/` : undefined}
                data-name={vm.name}
                data-vm-of={vm.ip ? undefined : r.name}
                data-state="checking"
              >
                <div class="min-w-0">
                  <p class="instrument normal-case text-fog truncate">{vm.name}</p>
                </div>
                <p class="tabular small text-fog text-right" data-status-ms>
                  {vm.ip && <span aria-hidden="true">···</span>}
                </p>
                <p class="instrument flex items-center justify-end gap-3">
                  <span class="tick" aria-hidden="true"></span>
                  <span data-status-text class="text-slate">Checking</span>
                </p>
              </li>
            ))}
            </>
          ))}
        </ul>
      </div>
    </section>

  <section class="section band border-t border-[var(--edge)]">
    <div class="shell grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="title">Down for you, up here?</h2>
        <p class="lead text-fog mt-6 max-w-lg">
          Open a ticket and paste what this page shows. The numbers tell us
          whether it's the node, the route, or your end.
        </p>
      </div>
      <div class="flex flex-col items-start gap-4 lg:pt-2">
        <a
          href={links.ticket}
          class="chamfer inline-flex items-center gap-2 bg-red px-7 py-4 font-medium text-ink transition-colors duration-150 hover:bg-red-pressed"
        >
          Open a ticket
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a href={links.discord} rel="noopener" target="_blank" class="small text-fog underline-offset-4 hover:text-paper hover:underline">
          Or ask in Discord
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* everything here sits on the 40px module so the cursor trail cells land
     on row lines, not across them. regions are two cells tall, vms one, the
     vm indent is one cell and the columns are whole cells too. content column
     is always a multiple of 40 so the 1fr name column comes out whole as well.
     lines are inset shadows not borders, a 1px border pushes every row below
     it a pixel off the anchor and it adds up by the bottom */
  .status-list {
    box-shadow: inset 0 1px 0 var(--edge);
  }
  .status-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(2 * var(--grid-cell)) calc(3 * var(--grid-cell));
    align-items: center;
    height: calc(2 * var(--grid-cell));
    box-shadow: inset 0 -1px 0 var(--edge);
  }
  @media (min-width: 640px) {
    .status-row {
      grid-template-columns: minmax(0, 1fr) calc(3 * var(--grid-cell)) calc(4 * var(--grid-cell));
      column-gap: var(--grid-cell);
    }
  }

  /* the diagonal again, sheared like everything else. slate while checking,
     green when it answers, red when it doesn't */
  .tick {
    display: inline-block;
    width: 0.55rem;
    height: 0.9rem;
    transform: skewX(var(--shear));
    background: var(--color-slate);
    transition: background-color 150ms;
  }
  [data-state="up"] .tick { background: var(--color-go); }
  [data-state="up"] [data-status-text] { color: var(--color-go); }
  [data-state="down"] .tick { background: var(--color-red); }
  [data-state="down"] [data-status-text] { color: var(--color-red-tint); }
  [data-state="checking"] .tick { opacity: 0.5; }

  /* vms hang off their region. indented and quieter so the three cities stay
     the thing you read first */
  .status-vm {
    height: var(--grid-cell);
    padding-left: var(--grid-cell);
  }
  .status-vm .tick { width: 0.4rem; height: 0.65rem; }
</style>

<script>
  import { medianPing } from "../lib/ping";

  const rows = [...document.querySelectorAll<HTMLElement>("[data-status-row]")];
  const headline = document.querySelector<HTMLElement>("[data-status-headline]")!;
  const stamp = document.querySelector<HTMLElement>("[data-status-stamp]")!;
  const button = document.querySelector<HTMLButtonElement>("[data-status-recheck]")!;

  function set(row: HTMLElement, state: "checking" | "up" | "down", ms: number | null) {
    row.dataset.state = state;
    row.querySelector("[data-status-text]")!.textContent =
      state === "checking" ? "Checking" : state === "up" ? "Up" : "Not answering";
    row.querySelector("[data-status-ms]")!.textContent = ms === null ? "—" : `${ms} ms`;

    // vms without an ip in locations.ts only know the node under them
    // answered. say "host up", not "up". ones with an ip are rows of their own
    if (state === "checking") return;
    document.querySelectorAll<HTMLElement>(`[data-vm-of="${row.dataset.name}"]`).forEach((vm) => {
      vm.dataset.state = state;
      vm.querySelector("[data-status-text]")!.textContent = state === "up" ? "Host up" : "Host down";
    });
  }

  async function check(row: HTMLElement) {
    const ms = await medianPing(row.dataset.url!, 4);
    set(row, ms === null ? "down" : "up", ms);
  }


  function summarise() {
    const down = rows.filter((r) => r.dataset.state === "down").map((r) => r.dataset.name!);
    const dot = '<span class="text-red">.</span>';
    if (!down.length) headline.innerHTML = `Everything's answering${dot}`;
    else if (down.length === rows.length) headline.innerHTML = `Nothing's answering. Check your connection${dot}`;
    else if (down.length === 1) headline.innerHTML = `${down[0]} isn't answering${dot}`;
    else headline.innerHTML = `${down.slice(0, -1).join(", ")} and ${down.at(-1)} aren't answering${dot}`;
  }

  let running = false;
  async function run() {
    if (running) return;
    running = true;
    button.disabled = true;
    // rows keep their last answer until the new one lands, resetting them
    // every minute just made the whole list blink
    button.textContent = "Checking";
    if (!navigator.onLine) {
      headline.innerHTML = `You're offline<span class="text-red">.</span>`;
      stamp.textContent = "Reconnect and check again.";
    } else {
      await Promise.all(rows.map(check));
      summarise();
      stamp.textContent = `Last checked ${new Date().toLocaleTimeString()}. Rechecks every minute while this tab is open.`;
    }
    button.disabled = false;
    button.textContent = "Check again";
    running = false;
  }

  button.addEventListener("click", run);
  run();
  // hidden tabs skip the tick, no point pinging for nobody
  setInterval(() => {
    if (document.visibilityState === "visible") run();
  }, 60_000);
</script>
