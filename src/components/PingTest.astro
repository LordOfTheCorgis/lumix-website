---
// ping to each region from the browser. every competitor has one and for
// fivem it's the number that closes the sale.
//
// timing lives in lib/ping.ts, /status uses the same one. 5 samples, drop
// the first, median. rough and the page says so.
// no pingUrl = skipped, none at all = renders nothing
import { HOSTING } from "../lib/locations";

interface Props {
  /** show every region, greyed if it has no endpoint. /regions wants that */
  all?: boolean;
  class?: string;
}
const { all = false, class: className = "" } = Astro.props;

const regions = all ? HOSTING : HOSTING.filter((r) => r.pingUrl);
const measurable = regions.filter((r) => r.pingUrl).length;
---

{regions.length > 0 && (
  <div class:list={["ping", className]} data-ping>
    <p class="instrument text-slate">Your ping from here</p>
    <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 max-w-sm">
      {regions.map((r) => (
        <li
          class:list={[
            "flex items-baseline justify-between gap-4 border-b border-[var(--edge)] pb-2",
            !r.pingUrl && "opacity-40",
          ]}
        >
          <span class="small">{r.city}</span>
          {r.pingUrl ? (
            <span class="tabular text-fog" data-ping-value data-url={r.pingUrl}>
              <span class="sr-only">measuring</span>
              <span aria-hidden="true">···</span>
            </span>
          ) : (
            <span class="instrument text-slate">soon</span>
          )}
        </li>
      ))}
    </ul>
    <p class="small text-slate mt-3 max-w-sm">
      {measurable > 0
        ? "Measured from your browser to each region just now. Rough, but in the right neighbourhood."
        : "Measured from your browser once each region has a test endpoint. Greyed ones aren't wired up yet."}
    </p>
  </div>
)}

<script>
  import { medianPing } from "../lib/ping";

  const cells = document.querySelectorAll<HTMLElement>("[data-ping-value]");

  async function measure(cell: HTMLElement) {
    const ms = await medianPing(cell.dataset.url!);
    if (ms === null) {
      cell.textContent = "—";
      return;
    }
    cell.textContent = `${ms} ms`;
    cell.classList.add("text-paper");
  }

  // on scroll into view, not load. 20 requests nobody asked for otherwise
  const host = document.querySelector("[data-ping]");
  if (host && cells.length) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      cells.forEach(measure);
    });
    io.observe(host);
  }
</script>
