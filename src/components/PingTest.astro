---
// Your ping to each region, measured in the browser. Bisect, Apex and
// RocketNode all have one and for FiveM it's the number that closes the sale;
// "23 ms to Dallas" beats any globe.
//
// Measures with fetch in no-cors mode against a URL per region, which gives an
// opaque response you can't read but can time. Five samples, drop the first
// (connection setup), median of the rest. It's a rough number and the page
// says so. Regions with no pingUrl are skipped; if none have one the whole
// component renders nothing, same convention as everything else on this site
// that waits on config.
import { HOSTING } from "../lib/locations";

interface Props {
  /** Show every region, with the ones that have no endpoint yet greyed out
      rather than dropped. /regions wants the full list; the home page only
      wants numbers. */
  all?: boolean;
  class?: string;
}
const { all = false, class: className = "" } = Astro.props;

const regions = all ? HOSTING : HOSTING.filter((r) => r.pingUrl);
const measurable = regions.filter((r) => r.pingUrl).length;
---

{regions.length > 0 && (
  <div class:list={["ping snap-kids", className]} data-ping>
    <p class="instrument text-slate">Your ping from here</p>
    <!-- Two columns in whole cells, rows one cell tall, so each rule sits on
         the cursor grid. -->
    <ul class="cell-cols m-0 w-full max-w-[calc(11*var(--grid-cell))] list-none gap-y-0 p-0 [--cols:2]">
      {regions.map((r) => (
        <li
          class:list={[
            "flex h-10 items-center justify-between gap-4 border-b border-[var(--edge)]",
            !r.pingUrl && "opacity-40",
          ]}
        >
          <span class="small">{r.city}</span>
          {r.pingUrl ? (
            <span class="tabular text-fog" data-ping-value data-url={r.pingUrl}>
              <span class="sr-only">measuring</span>
              <span aria-hidden="true">···</span>
            </span>
          ) : (
            <span class="instrument text-slate">soon</span>
          )}
        </li>
      ))}
    </ul>
    <p class="small text-slate max-w-sm pt-3">
      {measurable > 0
        ? "Measured from your browser to each region just now. Rough, but in the right neighbourhood."
        : "Measured from your browser once each region has a test endpoint. Greyed ones aren't wired up yet."}
    </p>
  </div>
)}

<script>
  import { pingMs } from "../scripts/ping";

  const cells = document.querySelectorAll<HTMLElement>("[data-ping-value]");

  async function measure(cell: HTMLElement) {
    const url = cell.dataset.url!;
    try {
      const ms = await pingMs(url);
      cell.textContent = `${ms} ms`;
      cell.classList.add("text-paper");
    } catch {
      cell.textContent = "—";
    }
  }

  // Run when it scrolls into view, not on load: five round trips to four
  // regions is twenty requests nobody asked for if they never scroll here.
  const host = document.querySelector("[data-ping]");
  if (host && cells.length) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      cells.forEach(measure);
    });
    io.observe(host);
  }
</script>
