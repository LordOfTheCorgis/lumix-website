---
// the one line about app hosting. home and /games both had their own copy.
// one plan, one link: you pick the language in the panel after you order
import { botHosting } from "../config";
import { orderUrl, price } from "../lib/order";

const { class: cls } = Astro.props;
const names = botHosting.runtimes.join(", ");
---

<p class:list={["small text-fog", cls]}>
  Running a Discord bot or an app instead? Application hosting is {price(botHosting.monthly)} a month,
  one plan for {names} and more.{" "}
  <a href={orderUrl(botHosting.pid)} class="text-paper underline underline-offset-4 hover:text-red">Order application hosting</a>.
</p>
