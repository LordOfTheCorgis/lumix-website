---
// fades in as one unit, for lines a console prints all at once. only the
// command should type

interface Props {
  delay?: number;      // only used when the parent has sequence={false}
  class?: string;
}

const { delay = 0, class: className = "" } = Astro.props;
---

<div data-line data-kind="span" data-delay={delay} class:list={["grid", className]}>
  <slot />
</div>
