---
// types its slot text a char at a time. text is server rendered in full so
// no-js and reduced motion get the finished line, the script blanks and
// replays. slot not prop, keeps the call site readable

interface Props {
  duration?: number;   // ms per character
  delay?: number;      // only used when the parent has sequence={false}
  as?: "span" | "p" | "div" | "h2" | "h3" | "li";
  class?: string;
}

const { duration = 60, delay = 0, as: Tag = "span", class: className = "" } = Astro.props;
---

<Tag
  data-line
  data-kind="type"
  data-duration={duration}
  data-delay={delay}
  class:list={["block", className]}
>
  <slot />
</Tag>
