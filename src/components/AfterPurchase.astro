---
// "What happens after you pay" — the three beats a buyer wants confirmed before
// they commit. Reusable: it's dropped on every game page under the plans, so the
// values come from config (one place to change the support email and invite) and
// the setup time is a prop in case a game ever provisions slower.
//
// Accent is the system red via text-red (--color-red, #FF4C4C), not a one-off hex,
// so it stays in step with the rest of the site.
import { links } from "../config";

interface Props {
  /** headline promise. provisioning is automatic on payment, so this is small. */
  minutes?: number;
}
const { minutes = 5 } = Astro.props;
const fromEmail = links.email;
---

<section class="section border-t border-[var(--edge)]">
  <div class="shell">
    <p class="instrument text-fog">After checkout</p>
    <h2 class="display-l mt-4">What happens after you pay<span class="text-red">.</span></h2>

    <ol class="m-0 mt-10 grid list-none grid-cols-1 gap-x-8 gap-y-10 p-0 sm:grid-cols-3">
      <li class="border-t border-[var(--edge)] pt-6">
        <span class="text-red" aria-hidden="true">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2 4.5 13.5H11l-1 8.5L19.5 10.5H13z" />
          </svg>
        </span>
        <h3 class="title mt-4">Instant setup</h3>
        <p class="small text-fog mt-3">
          Your server is live within {minutes} minutes. Provisioning is automatic
          the moment your invoice is paid, with nothing to set up on our side.
        </p>
      </li>

      <li class="border-t border-[var(--edge)] pt-6">
        <span class="text-red" aria-hidden="true">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
          </svg>
        </span>
        <h3 class="title mt-4">Check your inbox</h3>
        <p class="small text-fog mt-3">
          Your panel login arrives from
          <a href={`mailto:${fromEmail}`} class="text-paper underline decoration-[var(--edge-strong)] underline-offset-2 hover:decoration-red">{fromEmail}</a>,
          at the email you ordered with. Don't see it? Check your spam folder.
        </p>
      </li>

      <li class="border-t border-[var(--edge)] pt-6">
        <span class="text-red" aria-hidden="true">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L4 20l1.3-4.6A7.5 7.5 0 1 1 21 11.5z" />
          </svg>
        </span>
        <h3 class="title mt-4">Need help?</h3>
        <p class="small text-fog mt-3">
          <a href={links.discord} rel="noopener" target="_blank" class="inline-flex items-center gap-1.5 text-paper hover:text-red">
            Join our Discord <span aria-hidden="true">&nearr;</span>
          </a>
          and the people who actually run the hardware will get you sorted.
        </p>
      </li>
    </ol>
  </div>
</section>
