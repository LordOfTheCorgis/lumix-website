---
// magic ui's globe without react. same cobe underneath.
//
// two things from upstream don't work any more: it pins cobe 0.6.4 and drives
// rotation from onRender, which v2 deleted (globe just freezes on frame one,
// no error). v2 gives you update(state) and you own the loop. and it pulled in
// `motion` for one spring, that's the dozen lines in step().
//
// phi 0 / theta 0.5 was measured with four hosting markers, centroid landed
// 4px off centre on a 600px canvas. salt lake city's gone now so it sits a
// few degrees east. only reduced-motion people see the resting frame, left it. matches cobe's own locationToAngles too.

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

// red = a server lives here, paper = scrubbing point. same list the page
// prints as text, src/lib/locations.ts is the one copy. no third colour for
// mitigation, the one accent is already spent on the regions.
import { HOSTING, MITIGATION } from "../lib/locations";

// cobe wants 0..1 floats. red #ff4c4c, paper #f7f5f1
const RED: [number, number, number] = [1, 0.298, 0.298];
const PAPER: [number, number, number] = [0.97, 0.96, 0.95];

const MARKERS = [
  ...HOSTING.map((l) => ({ location: [l.lat, l.lng], size: 0.07, color: RED })),
  ...MITIGATION.map((l) => ({ location: [l.lat, l.lng], size: 0.04, color: PAPER })),
];
---

<div class:list={["globe", className]} data-globe>
  {/* decorative, every city is real text beside it. also the no-webgl fallback */}
  <canvas data-globe-canvas aria-hidden="true"></canvas>
  <script type="application/json" data-globe-markers set:html={JSON.stringify(MARKERS)} />
</div>

<style>
  .globe {
    position: relative;
    margin-inline: auto;
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 1;
  }

  .globe canvas {
    width: 100%;
    height: 100%;
    /* grab cursor only once it actually works */
    cursor: auto;
    opacity: 0;
    transition: opacity 500ms ease;
    contain: layout paint size;
    touch-action: pan-y;
  }

  .globe[data-ready] canvas {
    opacity: 1;
    cursor: grab;
  }

  .globe[data-dragging] canvas {
    cursor: grabbing;
  }
</style>

<script>
  const host = document.querySelector<HTMLElement>("[data-globe]");

  if (host) {
    const canvas = host.querySelector<HTMLCanvasElement>("[data-globe-canvas]")!;
    const markers: {
      location: [number, number];
      size: number;
      color: [number, number, number];
    }[] = JSON.parse(host.querySelector("[data-globe-markers]")!.textContent || "[]");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    let globe: { update: (s: any) => void; destroy: () => void } | null = null;
    let frame = 0;
    let width = 0;

    // rotation plus the spring that carries a flick. same numbers as
    // motion's useSpring upstream: mass 1, stiffness 100, damping 30
    let phi = 0;
    let target = 0;
    let value = 0;
    let velocity = 0;
    let dragStart: number | null = null;
    let last = 0;

    function measure() {
      width = canvas.offsetWidth;
    }

    function step(now: number) {
      frame = requestAnimationFrame(step);
      if (!globe) return;

      // clamp dt or a backgrounded tab comes back and flings it
      const dt = Math.min((now - last) / 1000 || 0, 1 / 30);
      last = now;

      const accel = (target - value) * 100 - velocity * 30;
      velocity += accel * dt;
      value += velocity * dt;

      // autorotate only when nobody's holding it and not under reduced
      // motion (still draggable there, just doesn't spin on its own)
      if (dragStart === null && !still.matches) phi += 0.005;

      globe.update({ phi: phi + value, width: width * 2, height: width * 2 });
    }

    async function start() {
      if (globe) return;
      measure();
      if (!width) return;

      const { default: createGlobe } = await import("cobe");
      globe = createGlobe(canvas, {
        devicePixelRatio: Math.min(window.devicePixelRatio, 2),
        width: width * 2,
        height: width * 2,
        phi: 0,
        theta: 0.5,
        dark: 1,
        diffuse: 0.5,
        mapSamples: 16000,
        // was 3.2 / 0.26, a black ball with grey freckles on a black page
        mapBrightness: 5,
        baseColor: [0.42, 0.34, 0.38],
        // fallback only, markers carry their own colour in cobe 2
        markerColor: [1, 0.298, 0.298],
        glowColor: [0.24, 0.17, 0.2],
        markers,
      });

      host!.setAttribute("data-ready", "");
      last = performance.now();
      frame = requestAnimationFrame(step);
    }

    function stop() {
      cancelAnimationFrame(frame);
      frame = 0;
      globe?.destroy();
      globe = null;
      host!.removeAttribute("data-ready");
    }

    // tear it down offscreen, it's just battery otherwise. phi lives outside
    // so it picks up where it stopped
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? start() : stop();
      },
      { rootMargin: "200px" }
    );
    io.observe(host);

    window.addEventListener("resize", () => {
      measure();
    });

    // pointer events cover mouse, touch and pen in one go
    canvas.addEventListener("pointerdown", (e) => {
      dragStart = e.clientX - value * 1400;
      host!.setAttribute("data-dragging", "");
      canvas.setPointerCapture(e.pointerId);
    });

    function release() {
      dragStart = null;
      host!.removeAttribute("data-dragging");
    }

    canvas.addEventListener("pointerup", release);
    canvas.addEventListener("pointercancel", release);

    canvas.addEventListener("pointermove", (e) => {
      if (dragStart === null) return;
      // 1400 = upstream's MOVEMENT_DAMPING, px per radian-ish
      target = (e.clientX - dragStart) / 1400;
    });
  }
</script>
