---
// sticky, transparent at the top, hairline + blur once scrolled. that's the
// only thing it does
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { nav, moreNav, links, site } from "../config";

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href !== "/" && (path === href || path.startsWith(href + "/"));

// More lights up when you're on a page inside it
const moreOpenish = moreNav.some((item) => isCurrent(item.href));
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-200"
>
  <div class="shell flex h-20 items-center gap-8">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label={`${site.name} home`}>
      <Image src={logo} alt="" width={32} height={32} class="h-8 w-8" />
      <span class="instrument hidden text-paper sm:block">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="ml-auto hidden items-center gap-8 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class:list={[
            "text-sm transition-colors duration-150 hover:text-paper",
            isCurrent(item.href) ? "text-paper" : "text-fog",
          ]}
        >
          {item.label}
        </a>
      ))}

      <!-- no chamfer on the panel, it clips the focus ring on the first and
           last link -->
      <div class="relative" data-more>
        <button
          type="button"
          data-more-toggle
          aria-expanded="false"
          aria-controls="more-menu"
          class:list={[
            "flex items-center gap-1.5 text-sm transition-colors duration-150 hover:text-paper",
            moreOpenish ? "text-paper" : "text-fog",
          ]}
        >
          More
          <svg
            data-more-arrow
            aria-hidden="true"
            viewBox="0 0 10 6"
            class="h-1.5 w-2.5 transition-transform duration-200"
          >
            <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>

        <div
          id="more-menu"
          data-more-panel
          hidden
          class="absolute right-0 top-full z-50 mt-4 w-72 border border-[var(--edge)] bg-ink/95 p-2 backdrop-blur-md"
        >
          {moreNav.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
              class:list={[
                "block px-3 py-2.5 transition-colors duration-150 hover:bg-ink-soft",
                isCurrent(item.href) ? "bg-ink-soft" : "",
              ]}
            >
              <span class:list={["block text-sm", isCurrent(item.href) ? "text-paper" : "text-fog"]}>
                {item.label}
              </span>
              <span class="small block text-slate">{item.note}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- the one red thing up here. ink on red, paper fails contrast -->
    <a
      href={links.billing}
      class="chamfer ml-auto hidden bg-red px-4 py-2 text-sm font-medium text-ink transition-colors duration-150 hover:bg-red-pressed md:ml-0 md:block"
    >
      Client area
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="ml-auto flex h-10 w-10 items-center justify-center md:hidden"
    >
      <span class="sr-only">Menu</span>
      <span data-menu-icon class="relative block h-3 w-5">
        <span class="absolute left-0 top-0 h-px w-full bg-paper transition-transform duration-200"></span>
        <span class="absolute bottom-0 left-0 h-px w-full bg-paper transition-transform duration-200"></span>
      </span>
    </button>
  </div>

  <div
    id="mobile-nav"
    data-menu-panel
    hidden
    class="border-t border-[var(--edge)] bg-ink md:hidden"
  >
    <nav aria-label="Primary" class="shell flex flex-col py-4">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class:list={[
            "border-b border-[var(--edge)] py-4 text-sm last:border-b-0",
            isCurrent(item.href) ? "text-paper" : "text-fog",
          ]}
        >
          {item.label}
        </a>
      ))}
      <p class="instrument text-slate mt-6">More</p>
      {moreNav.map((item) => (
        <a
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
          class:list={[
            "border-b border-[var(--edge)] py-4 text-sm last:border-b-0",
            isCurrent(item.href) ? "text-paper" : "text-fog",
          ]}
        >
          {item.label}
        </a>
      ))}

      <a
        href={links.billing}
        class="chamfer mt-6 bg-red px-4 py-3 text-center text-sm font-medium text-ink"
      >
        Client area
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  if (header) {
    // class swap so the transition still applies. 8px not 0 so rubber-band
    // scroll doesn't flicker it
    const onScroll = () => {
      const scrolled = window.scrollY > 8;
      header.classList.toggle("border-[var(--edge)]", scrolled);
      header.classList.toggle("border-transparent", !scrolled);
      header.classList.toggle("bg-ink/80", scrolled);
      header.classList.toggle("backdrop-blur-md", scrolled);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(panel.hidden);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // resize into desktop with it open leaves it stuck open behind md:
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // the More drawer
  const more = document.querySelector<HTMLElement>("[data-more]");
  const moreToggle = more?.querySelector<HTMLButtonElement>("[data-more-toggle]");
  const morePanel = more?.querySelector<HTMLElement>("[data-more-panel]");
  const moreArrow = more?.querySelector<SVGElement>("[data-more-arrow]");

  if (more && moreToggle && morePanel) {
    let hoverTimer: number | undefined;

    const setMore = (open: boolean) => {
      morePanel.hidden = !open;
      moreToggle.setAttribute("aria-expanded", String(open));
      moreArrow?.classList.toggle("rotate-180", open);
    };

    moreToggle.addEventListener("click", () => setMore(morePanel.hidden));

    // hover only with a real pointer. on touch the hover fires on tap and the
    // click closes it straight after, looks like it refuses to open
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      more.addEventListener("pointerenter", () => {
        clearTimeout(hoverTimer);
        setMore(true);
      });
      // grace period for a diagonal path to the panel
      more.addEventListener("pointerleave", () => {
        hoverTimer = window.setTimeout(() => setMore(false), 120);
      });
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !morePanel.hidden) {
        setMore(false);
        moreToggle.focus();
      }
    });

    // down arrow opens and focuses the first link
    moreToggle.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      event.preventDefault();
      setMore(true);
      morePanel.querySelector<HTMLAnchorElement>("a")?.focus();
    });

    document.addEventListener("pointerdown", (event) => {
      if (!morePanel.hidden && !more.contains(event.target as Node)) setMore(false);
    });

    // tabbing out the far end closes it too
    more.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!more.contains(document.activeElement)) setMore(false);
      });
    });
  }
</script>
