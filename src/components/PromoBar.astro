---
// the line above the header. every competitor has one. red-pressed with
// paper text after ink-soft (too quiet), gold (evan: no), paper (evan: too
// bright). paper on pressed red is 4.94:1. a strip not a control so it
// doesn't count against the two reds. no dismiss, no js
import { promo } from "../config";
---

{promo.live && (
  <div class="bg-red-pressed text-paper">
    <p class="shell instrument flex h-9 items-center justify-center gap-2">
      <span>{promo.percent}% off any game server with code</span>
      <span class="font-bold">{promo.code}</span>
    </p>
  </div>
)}
