---
// The one line above the header. Every competitor crawled on 2026-09-11 runs
// one of these (Apex: "25% off on first order with APEX25") and it's the
// first thing on the page. Ours is red-pressed with paper text. Went through
// ink-soft (too quiet), gold (Evan: no), paper (Evan: too bright). Pressed
// red is the brand at half volume: reads as Lumix, doesn't glare, and paper
// on it is 4.94:1 so it passes. It's a strip, not a control, so it doesn't
// count against the two-reds rule. No dismiss button, no JS.
import { promo } from "../config";
---

{promo.live && (
  <div class="bg-red-pressed text-paper">
    <p class="shell instrument flex h-9 items-center justify-center gap-2">
      <span>{promo.percent}% off any game server with code</span>
      <span class="font-bold text-ink">{promo.code}</span>
    </p>
  </div>
)}
