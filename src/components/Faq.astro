---
// native <details>, no js, same list as FAQPage json-ld. every competitor
// has one and two of them answer refunds and trials in it, which is the
// honest place for that
import { FAQ } from "../lib/faq";
import { links } from "../config";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<section class:list={["section border-t border-[var(--edge)]", className]}>
  <div class="shell grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <!-- sticky so the column rides alongside ten questions -->
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 class="title">Before you order<span class="text-red">.</span></h2>
      <p class="lead text-fog mt-6 max-w-sm">
        The questions people ask in Discord before they buy, answered once.
      </p>

      <div class="chamfer mt-10 max-w-sm border border-[var(--edge)] bg-ink-soft p-6">
        <p class="instrument text-slate">Not answered here</p>
        <p class="mt-3 text-paper">
          Ask in Discord. You'll get someone who actually runs the
          hardware, and if it's a real gap we add it to this list.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={links.discord}
            rel="noopener"
            class="chamfer inline-flex items-center gap-2 border border-[var(--edge-strong)] px-5 py-3 text-sm font-medium text-paper transition-colors duration-150 hover:border-red hover:text-red"
          >
            Ask in Discord
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={links.billing} class="small text-fog underline underline-offset-4 hover:text-paper">
            Open a ticket
          </a>
        </div>
      </div>
    </div>

    <div class="faq divide-y divide-[var(--edge)] border-y border-[var(--edge)]" data-faq>
      {FAQ.map((f) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center gap-6 py-5 font-medium text-paper">
            <span>{f.q}</span>
            <span
              aria-hidden="true"
              class="ml-auto shrink-0 text-fog transition-transform duration-150 group-open:rotate-45"
            >+</span>
          </summary>
          <div class="faq-a" data-faq-a>
            <p class="text-fog max-w-2xl pb-6">{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* safari draws the triangle unless you say so twice */
  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq span {
      transition: none;
    }
  }
</style>

<script>
  import { animate } from "animejs";

  const still = window.matchMedia("(prefers-reduced-motion: reduce)");
  const box = document.querySelector<HTMLElement>("[data-faq]");

  // no js / reduced motion = the native <details> snap, which is fine. this only
  // layers a height tween on top for everyone else. semantics + json-ld are
  // untouched either way
  if (box && !still.matches) {
    box.querySelectorAll<HTMLDetailsElement>("details").forEach((d) => {
      const summary = d.querySelector<HTMLElement>("summary")!;
      const panel = d.querySelector<HTMLElement>("[data-faq-a]")!;
      let busy = false;

      // <details> renders its content only while open, so we drive open/close
      // by hand: open first, animate up; animate down, then close. keeps the
      // panel measurable and the content from vanishing mid-close
      summary.addEventListener("click", (e) => {
        e.preventDefault();
        if (busy) return;
        busy = true;
        panel.style.overflow = "hidden";

        if (!d.open) {
          d.open = true;
          animate(panel, {
            height: [0, panel.scrollHeight],
            opacity: [0, 1],
            translateY: [-6, 0],
            duration: 260,
            ease: "out(3)",
            onComplete: () => {
              // hand height back to the layout so it reflows on resize
              panel.style.height = "";
              panel.style.overflow = "";
              busy = false;
            },
          });
        } else {
          animate(panel, {
            height: [panel.scrollHeight, 0],
            opacity: [1, 0],
            duration: 200,
            ease: "out(2)",
            onComplete: () => {
              d.open = false;
              panel.style.height = "";
              panel.style.opacity = "";
              panel.style.transform = "";
              panel.style.overflow = "";
              busy = false;
            },
          });
        }
      });
    });
  }
</script>
