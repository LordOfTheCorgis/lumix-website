---
// Native <details>, no JS (the open/close glide is CSS only), and the same list rendered as FAQPage JSON-LD so
// Google can show the answers under the result. Every competitor crawled on
// 2026-09-11 has one of these and two of them (RocketNode, Shockbyte) use it
// to answer refunds and trials head-on, which is the honest place for that.
import { FAQ } from "../lib/faq";
import { links } from "../config";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<section class:list={["section border-t border-[var(--edge)]", className]}>
  <div class="shell cell-split" style="--left: calc(var(--n, 32) / 3)">
    <!-- Sticky on desktop so the column rides alongside ten questions instead
         of leaving a hole under the heading. The exit for "read all of it,
         still not sure" lives here because this is where that person is. -->
    <div class="cell-stack lg:sticky lg:top-28 lg:self-start">
      <h2 class="title">Before you order<span class="text-red">.</span></h2>
      <p class="lead text-fog mt-6 max-w-sm">
        The questions people ask in Discord before they buy, answered once.
      </p>

      <div class="chamfer cell-stack w-full max-w-[calc(10*var(--grid-cell))] border border-[var(--edge)] bg-ink-soft p-[calc(var(--grid-cell)-1px)]">
        <p class="instrument text-slate">Not answered here</p>
        <p class="text-paper">
          Ask in Discord. You'll get someone who actually runs the
          hardware, and if it's a real gap we add it to this list.
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={links.discord}
            rel="noopener"
            data-snap="both"
            class="chamfer inline-flex h-10 items-center gap-2 border border-[var(--edge-strong)] px-5 text-sm font-medium text-paper transition-colors duration-150 hover:border-red hover:text-red"
          >
            Ask in Discord
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href={links.billing} class="small text-fog underline underline-offset-4 hover:text-paper">
            Open a ticket
          </a>
        </div>
      </div>
    </div>

    <div class="faq">
      {FAQ.map((f) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center gap-6 py-5 font-medium text-paper" data-snap>
            <span>{f.q}</span>
            <span
              aria-hidden="true"
              class="ml-auto shrink-0 text-fog transition-transform duration-150 group-open:rotate-45"
            >+</span>
          </summary>
          <p class="text-fog max-w-2xl pb-6" data-snap>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Safari still draws the disclosure triangle unless you say so twice. */
  summary::-webkit-details-marker {
    display: none;
  }

  /* Row rules as inset shadows rather than borders. A 1px border per row
     sits outside the snapped heights and drifts the list a pixel per
     question off the cursor grid; a shadow takes no space. */
  .faq {
    box-shadow: inset 0 1px 0 var(--edge), inset 0 -1px 0 var(--edge);
  }
  .faq > details + details {
    box-shadow: inset 0 1px 0 var(--edge);
  }

  summary:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: 2px;
  }

  /* Open and close glide instead of snapping, still with zero JS. Height to
     `auto` only animates with interpolate-size, which is Chromium-only right
     now; everyone else gets the old instant toggle, which is fine, so the
     whole thing is gated rather than half-working in Safari (it knows
     ::details-content but would snap the height and only fade).
     content-visibility has to transition too or the close gets cut off: the
     browser hides the content the moment [open] drops, before the height has
     gone anywhere. */
  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }

    details::details-content {
      block-size: 0;
      overflow: clip;
      opacity: 0;
      transition:
        block-size 240ms cubic-bezier(0.2, 0, 0, 1),
        opacity 180ms ease-out,
        content-visibility 240ms allow-discrete;
    }

    details[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq span {
      transition: none;
    }

    /* The global reduce rule already squashes durations, this just makes it
       not depend on that. */
    details::details-content {
      transition: none;
    }
  }
</style>
