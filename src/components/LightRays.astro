---
// Light rays, ported off the React/motion version. Zero JS: the randomisation
// happens here at build time and the animation is plain CSS keyframes, so there
// is no hydration, no layout shift, and nothing to run on the main thread.
//
// The company is named Lumix and this is light. That's the entire justification
// for breaking the ambient-motion rule in DESIGN.md section 9, and it's the only
// place on the site that gets to break it.
//
// Default colour is Paper at low alpha, not the original's blue. A new hue would
// be a fourth colour in a palette that has a hard budget.

interface Props {
  count?: number;
  color?: string;
  blur?: number;
  speed?: number;   // seconds for an average cycle
  length?: string;
  seed?: number;
  class?: string;
}

const {
  count = 6,
  color = "rgba(247, 245, 241, 0.20)",
  blur = 40,
  speed = 16,
  length = "70vh",
  seed = 7,
  class: className = "",
} = Astro.props;

// Seeded so a rebuild produces the same sky. Math.random() here would mean the
// rays quietly rearrange on every deploy, which is impossible to eyeball-diff.
function makeRng(s: number) {
  let state = s >>> 0;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 4294967296;
  };
}

const rand = makeRng(seed);
const cycle = Math.max(speed, 0.1);

const rays = Array.from({ length: Math.max(0, count) }, () => {
  const rotate = -28 + rand() * 56;
  const swing = 0.8 + rand() * 1.8;
  return {
    left: 8 + rand() * 84,
    width: 160 + rand() * 160,
    rotMin: rotate - swing,
    rotMax: rotate + swing,
    delay: rand() * cycle,
    duration: cycle * (0.75 + rand() * 0.5),
    intensity: 0.6 + rand() * 0.4,
  };
});
---

<div
  class:list={["light-rays", className]}
  aria-hidden="true"
  style={`--rays-color:${color};--rays-blur:${blur}px;--rays-length:${length};`}
>
  <div class="wash wash-left"></div>
  <div class="wash wash-right"></div>
  {rays.map((ray) => (
    <div
      class="ray"
      style={`--left:${ray.left.toFixed(2)}%;--width:${ray.width.toFixed(0)}px;--rot-min:${ray.rotMin.toFixed(2)}deg;--rot-max:${ray.rotMax.toFixed(2)}deg;--intensity:${ray.intensity.toFixed(2)};animation-duration:${ray.duration.toFixed(2)}s;animation-delay:${ray.delay.toFixed(2)}s;`}
    >
    </div>
  ))}
</div>

<style>
  .light-rays {
    position: absolute;
    inset: 0;
    isolation: isolate;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
  }

  .wash {
    position: absolute;
    inset: 0;
    opacity: 0.6;
  }

  .wash-left {
    background: radial-gradient(
      circle at 20% 15%,
      color-mix(in srgb, var(--rays-color) 45%, transparent),
      transparent 70%
    );
  }

  .wash-right {
    background: radial-gradient(
      circle at 80% 10%,
      color-mix(in srgb, var(--rays-color) 35%, transparent),
      transparent 75%
    );
  }

  .ray {
    position: absolute;
    top: -12%;
    left: var(--left);
    width: var(--width);
    height: var(--rays-length);
    transform-origin: top center;
    border-radius: 9999px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--rays-color) 70%, transparent),
      transparent
    );
    filter: blur(var(--rays-blur));
    mix-blend-mode: screen;
    opacity: 0;
    animation-name: ray-sweep;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes ray-sweep {
    0% {
      opacity: 0;
      transform: translateX(-50%) rotate(var(--rot-min));
    }
    50% {
      opacity: var(--intensity);
      transform: translateX(-50%) rotate(var(--rot-max));
    }
    100% {
      opacity: 0;
      transform: translateX(-50%) rotate(var(--rot-min));
    }
  }

  /* Six blurred, screen-blended layers is a real compositing cost, and phones
     feel it first. Half the rays below the small breakpoint. */
  @media (max-width: 640px) {
    .ray:nth-child(n + 6) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ray {
      animation: none;
      opacity: calc(var(--intensity) * 0.7);
      transform: translateX(-50%) rotate(var(--rot-min));
    }
  }
</style>
