---
// hero ground: one game's key art per visit, dimmed, beams over it.
//
// before this it was copy over an empty dark room and evan said "bland, not
// colourful". palette is ink and one red, so the colour has to come from the
// games. picked client side (static site, nothing to hash on). only the
// chosen image loads. sessionStorage stops a reload showing the same one.
import { getImage } from "astro:assets";

interface Props {
  games: { slug: string; image: ImageMetadata; accent: string }[];
  class?: string;
}

const { games, class: className = "" } = Astro.props;

// under 1200 wide gets skipped. terraria's is a 460px thumbnail and it's mush
// at hero size. width rule not a slug list so it comes back when someone drops
// a real image in
const HERO_MIN_WIDTH = 1200;

// 1600 is plenty, hero caps at 1328 and it's behind a veil anyway
const art = await Promise.all(
  games.filter((g) => g.image.width >= HERO_MIN_WIDTH).map(async (g) => {
    const img = await getImage({ src: g.image, width: 1600, format: "webp", quality: 68 });
    return { slug: g.slug, src: img.src, accent: g.accent };
  })
);
---

<div class:list={["hero-art", className]} aria-hidden="true" data-hero-art>
  <img alt="" decoding="async" fetchpriority="high" data-hero-img />
  <div class="veil"></div>
  <script type="application/json" data-hero-art-list set:html={JSON.stringify(art)} />
  <script is:inline>
    // inline so the src lands before first paint. as a module script the veil
    // paints over nothing and the art pops in a frame late
    (function () {
      var host = document.querySelector("[data-hero-art]");
      if (!host) return;
      var img = host.querySelector("[data-hero-img]");
      var list = JSON.parse(host.querySelector("[data-hero-art-list]").textContent || "[]");
      if (!list.length) return;

      var last = -1;
      try { last = Number(sessionStorage.getItem("hero-art")); } catch (e) {}
      var i = Math.floor(Math.random() * list.length);
      if (list.length > 1 && i === last) i = (i + 1) % list.length;

      // ?art=fivem pins one for checking crops. costs nothing, leave it
      var pin = new URLSearchParams(location.search).get("art");
      for (var k = 0; pin && k < list.length; k++) if (list[k].slug === pin) i = k;

      try { sessionStorage.setItem("hero-art", String(i)); } catch (e) {}

      host.setAttribute("data-game", list[i].slug);
      // LightRays is a sibling and reads this off the section
      var section = host.closest("section") || host.parentElement;
      if (section && list[i].accent) section.style.setProperty("--game-accent", list[i].accent);
      img.addEventListener("load", function () { host.setAttribute("data-loaded", ""); });
      img.src = list[i].src;
      if (img.complete && img.naturalWidth) host.setAttribute("data-loaded", "");
    })();
  </script>
  <noscript>
    <img src={art[0]?.src} alt="" class="fallback" />
  </noscript>
</div>

<style>
  .hero-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* framed right, that's where the light falls and the copy isn't */
    object-position: 68% 45%;
    /* not greyscale, colour is the whole point. .38/.5 made terraria vanish,
       this is as far as it goes before the fivem red car fights the CTA */
    filter: saturate(0.62) brightness(0.62) contrast(1.06);
    opacity: 0;
    transition: opacity 900ms ease 120ms;
  }

  .hero-art[data-loaded] img,
  .hero-art .fallback {
    opacity: 1;
  }

  /* ink shelf under the headline on the left, ink at the bottom so the art
     meets the hairline instead of getting sliced by it */
  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        var(--color-ink) 0%,
        var(--color-ink) 28%,
        color-mix(in srgb, var(--color-ink) 65%, transparent) 55%,
        color-mix(in srgb, var(--color-ink) 18%, transparent) 100%
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-ink) 55%, transparent) 0%,
        transparent 35%,
        color-mix(in srgb, var(--color-ink) 40%, transparent) 75%,
        var(--color-ink) 100%
      );
  }

  @media (max-width: 640px) {
    .hero-art img {
      object-position: 60% 45%;
    }
    /* narrow: copy is full width so the shelf comes from the top */
    .veil {
      background:
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--color-ink) 82%, transparent) 0%,
          color-mix(in srgb, var(--color-ink) 62%, transparent) 55%,
          var(--color-ink) 100%
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art img {
      transition: none;
    }
  }
</style>
