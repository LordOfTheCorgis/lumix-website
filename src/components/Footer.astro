---
// no red down here, the header spends it
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import logo from "../assets/logo.png";
import { footerNav, social, site } from "../config";

const year = new Date().getFullYear();
const external = (href: string) => href.startsWith("http");

// games column comes off the collection so a new yaml shows up on its own.
// socials moved up from the bottom line so the copyright could sit alone
const games = (await getCollection("games"))
  .filter((g) => g.data.status === "live")
  .sort((a, b) => a.data.shortLabel.localeCompare(b.data.shortLabel));

const columns = [
  footerNav[0],
  {
    heading: "Games",
    items: games.map((g) => ({ label: g.data.shortLabel, href: `/games/${g.data.slug}` })),
  },
  ...footerNav.slice(1),
  { heading: "Social", items: social },
];
---

<footer class="mt-auto border-t border-[var(--edge)]">
  <div class="shell py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_3fr] lg:gap-20">
      <div>
        <a href="/" class="flex items-center gap-3" aria-label={`${site.name} home`}>
          <Image src={logo} alt="" width={32} height={32} class="h-8 w-8" />
          <span class="instrument text-paper">{site.name}</span>
        </a>
        <p class="small text-fog mt-5 max-w-xs">{site.tagline}</p>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:grid-cols-5">
        {columns.map((group) => (
          <div>
            <h2 class="instrument text-slate">{group.heading}</h2>
            <ul class="mt-5 space-y-3">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    rel={external(item.href) ? "noopener" : undefined}
                    class="text-sm text-fog transition-colors duration-150 hover:text-paper"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 border-t border-[var(--edge)] pt-8">
      <p class="small text-center text-slate">© {year} {site.legalName}. All rights reserved.</p>
    </div>
  </div>
</footer>
