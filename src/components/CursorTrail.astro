---
// magic ui's interactive grid minus the grid. no lines drawn, 12 divs recycled
// for the trail, fade on WAAPI. listens on window so cells light up under the
// header/copy too (the react one goes dead under anything on top of it).
//
// cells snap to --grid-cell (40px) and the layout is built to that module, so
// a lit cell lands in a tile corner instead of across a border. plane is page
// sized, not viewport: viewport height clips everything below the fold and a
// fixed origin can't register vertically once you scroll.
//
// vertical origin is looked up per pointer: the nearest section edge or
// [data-grid-anchor] panel group above it. snap() below then makes all of
// those share one phase by rounding sections and panels to whole cells,
// because left alone section heights are text and text isn't a multiple of
// 40: the rule between two sections ends up wherever the copy above it
// stopped and no cell can sit on it.
//
// plane stops at the footer, that's Layout.astro's call not ours.

interface Props {
  /** Fill of a lit cell at full strength, before it starts fading out. */
  tint?: string;
  /** How long a lit cell takes to fade back to nothing, in ms. */
  fade?: number;
  /** Cells that can be mid-fade at once. Past ~16 the trail reads as a smear. */
  trail?: number;
  class?: string;
}

const {
  tint = "rgba(247, 245, 241, 0.07)",
  fade = 900,
  trail = 12,
  class: className = "",
} = Astro.props;
---

<div
  class:list={["cursor-trail", className]}
  aria-hidden="true"
  data-cursor-trail
  data-fade={fade}
  style={`--trail-tint:${tint};`}
>
  {Array.from({ length: trail }, () => <i class="cell"></i>)}
</div>

<style>
  .cursor-trail {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .cell {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--grid-cell);
    height: var(--grid-cell);
    background: var(--trail-tint);
    opacity: 0;
    /* no will-change, WAAPI promotes it while animating. 12 permanent layers
       for nothing otherwise */
  }
</style>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  // no mouse or reduced motion = do nothing at all
  if (fine.matches && !still.matches) {
    document.querySelectorAll<HTMLElement>("[data-cursor-trail]").forEach((plane) => {
      const size =
        parseFloat(getComputedStyle(plane).getPropertyValue("--grid-cell")) || 40;
      const fade = Number(plane.dataset.fade) || 900;
      const slots = Array.from(plane.querySelectorAll<HTMLElement>(".cell"));
      if (!slots.length) return;

      // where the module lines fall, document coords. measured not assumed
      let originX = 0;
      // plane doesn't start at 0,0 of the document. assumed it did once, every
      // cell ended up pinned to the top
      let planeX = 0;
      let planeY = 0;
      let planeBottom = Infinity;
      // document-space tops of every section and anchored panel group, sorted.
      // never empty, see measure()
      let lineTops: number[] = [0];

      // top-level sections only. a section inside a section is the outer one's
      // business
      const sections = () =>
        [...document.querySelectorAll<HTMLElement>("main section")].filter(
          (s) => !s.parentElement?.closest("section")
        );
      const anchors = () => [...document.querySelectorAll<HTMLElement>("[data-grid-anchor]")];
      const px = (v: string) => parseFloat(v) || 0;

      function measure() {
        const pb = plane.getBoundingClientRect();
        planeX = pb.left;
        planeY = pb.top + window.scrollY;
        planeBottom = planeY + pb.height;

        // any .shell, they're all the same width
        const shell = document.querySelector<HTMLElement>(".shell");
        if (shell) {
          const box = shell.getBoundingClientRect();
          originX = box.left + (parseFloat(getComputedStyle(shell).paddingLeft) || 0);
        }
        // vertical has to be measured, there's no css for "where did this land".
        // the lines a cell has to sit on are section edges (border-t, the band
        // fill) and the first panel of every anchored group. after snap() they
        // all share one phase, this is just where the pointer looks it up.
        // first child not the anchor: a ledger's border-t sits on the list and
        // would shove every row 1px off
        const tops = [
          ...sections().map((el) => el.getBoundingClientRect().top),
          ...anchors().map((el) => ((el.firstElementChild as HTMLElement) ?? el).getBoundingClientRect().top),
        ].map((t) => t + window.scrollY);
        if (!tops.length) {
          const main = document.querySelector<HTMLElement>("main");
          if (main) tops.push(main.getBoundingClientRect().top + window.scrollY);
        }
        lineTops = tops.length ? tops.sort((a, b) => a - b) : [0];
      }

      // nearest line at or above y, else the first one below it. half a pixel
      // of slack so a pointer exactly on the top edge counts as inside
      function originYFor(y: number) {
        let top = lineTops[0];
        for (const t of lineTops) if (t <= y + 0.5) top = t;
        return ((top % size) + size) % size;
      }

      // pin a box to whole cells. under a pixel over a multiple (text
      // line-height is 26.4px, so 280.5 happens) it's pinned down to the
      // multiple, the spill sits inside the padding and min-height alone can't
      // pull a box back under its content. anything bigger rounds up
      function toCells(el: HTMLElement, h: number) {
        if (h <= 0) return;
        const below = Math.floor(h / size) * size;
        if (below > 0 && h - below <= 1) el.style.height = `${below}px`;
        else el.style.minHeight = `${Math.ceil(h / size) * size}px`;
      }

      // put the whole page on one lattice. a rule or fill edge that isn't a
      // multiple of 40 from the line above it can never be hit by a cell, and
      // section heights are text. so, in order:
      //   1. clear everything we set last time or it reads as natural size
      //   2. round every anchored panel to whole cells
      //   3. push each anchored group down (section padding for the first one,
      //      margin for any others) until its first panel is a whole number of
      //      cells below the section's top edge
      //   4. round every section to whole cells, so the next section's top
      //      edge is on the lattice too
      // the cost is up to 39px of extra air at a block's top and bottom. that's
      // the trade, same as the shell snapping
      function snap() {
        const secs = sections();
        const groups = anchors();

        secs.forEach((el) => {
          el.style.minHeight = "";
          el.style.height = "";
          el.style.paddingTop = "";
        });
        groups.forEach((g) => {
          g.style.marginTop = "";
          [...g.children].forEach((k) => {
            (k as HTMLElement).style.minHeight = "";
            (k as HTMLElement).style.height = "";
          });
        });

        groups.forEach((g) => {
          const kids = [...g.children] as HTMLElement[];
          const heights = kids.map((k) => k.getBoundingClientRect().height);
          kids.forEach((k, i) => toCells(k, heights[i]));
        });

        secs.forEach((sec) => {
          groups
            .filter((g) => sec.contains(g))
            .forEach((g, i) => {
              const first = (g.firstElementChild as HTMLElement) ?? g;
              const d = first.getBoundingClientRect().top - sec.getBoundingClientRect().top;
              const extra = (size - (d % size)) % size;
              // already on a line, or off by sub-pixel noise
              if (extra < 0.5 || extra > size - 0.5) return;
              if (i === 0) sec.style.paddingTop = `${px(getComputedStyle(sec).paddingTop) + extra}px`;
              else g.style.marginTop = `${px(getComputedStyle(g).marginTop) + extra}px`;
            });
        });

        secs.forEach((sec) => toCells(sec, sec.getBoundingClientRect().height));
      }

      let busy = false;
      function relayout() {
        if (busy) return;
        busy = true;
        snap();
        measure();
        busy = false;
      }

      relayout();
      // fonts, images and the FAQ opening all change heights and none of them
      // fire resize. debounced: the accordion animates, one pass at the end is
      // enough. snapping is idempotent so its own size changes settle in one
      // extra callback and stop
      let settle = 0;
      new ResizeObserver(() => {
        clearTimeout(settle);
        settle = window.setTimeout(relayout, 90);
      }).observe(document.body);
      // the FAQ animates open in 260ms, so one pass after it lands. the observer
      // above should catch it already, this is the belt to its braces
      document.addEventListener(
        "toggle",
        () => {
          clearTimeout(settle);
          settle = window.setTimeout(relayout, 320);
        },
        true
      );
      // webfonts change line wraps, which changes every natural height
      document.fonts.ready.then(relayout);
      window.addEventListener("load", relayout);
      let resizeFrame = 0;
      window.addEventListener("resize", () => {
        cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(relayout);
      });

      const running = new WeakMap<HTMLElement, Animation>();
      let next = 0;
      let lastCol = NaN;
      let lastRow = NaN;
      let lastOy = NaN;
      let pending: { x: number; y: number } | null = null;
      let frame = 0;

      function light(col: number, row: number, oy: number) {
        const el = slots[next];
        next = (next + 1) % slots.length;

        // slot might still be fading, kill it or they stack and flicker
        running.get(el)?.cancel();

        el.style.transform = `translate3d(${col * size + originX - planeX}px, ${
          row * size + oy - planeY
        }px, 0)`;

        // snap on, drift off. WAAPI not a class toggle, restarting a css
        // transition forces a reflow per cell
        running.set(
          el,
          el.animate([{ opacity: 1 }, { opacity: 1, offset: 0.08 }, { opacity: 0 }], {
            duration: fade,
            easing: "ease-out",
          })
        );
      }

      function flush() {
        frame = 0;
        if (!pending) return;
        const { x, y } = pending;
        pending = null;
        // over the footer, the clip eats it anyway
        if (y < planeY || y >= planeBottom) {
          lastCol = NaN;
          lastRow = NaN;
          return;
        }
        const col = Math.floor((x - originX) / size);
        const oy = originYFor(y);
        const row = Math.floor((y - oy) / size);
        if (col === lastCol && row === lastRow && oy === lastOy) return;
        lastCol = col;
        lastRow = row;
        lastOy = oy;
        light(col, row, oy);
      }

      window.addEventListener(
        "pointermove",
        (e) => {
          if (e.pointerType !== "mouse") return;
          // plane is document space, pointer is viewport space
          pending = { x: e.clientX, y: e.clientY + window.scrollY };
          if (!frame) frame = requestAnimationFrame(flush);
        },
        { passive: true }
      );

      // leave the window and the last cell stays lit otherwise
      window.addEventListener("blur", () => {
        lastCol = NaN;
        lastRow = NaN;
      });
    });
  }
</script>
