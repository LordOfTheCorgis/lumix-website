---
// magic ui's interactive grid minus the grid. no lines drawn, 12 divs recycled
// for the trail, fade on WAAPI. listens on window so cells light up under the
// header/copy too (the react one goes dead under anything on top of it).
//
// cells snap to --grid-cell (40px) and the layout is built to that module, so
// a lit cell lands in a tile corner instead of across a border. plane is page
// sized, not viewport: viewport height clips everything below the fold and a
// fixed origin can't register vertically once you scroll.
//
// plane stops at the footer, that's Layout.astro's call not ours.

interface Props {
  /** Fill of a lit cell at full strength, before it starts fading out. */
  tint?: string;
  /** How long a lit cell takes to fade back to nothing, in ms. */
  fade?: number;
  /** Cells that can be mid-fade at once. Past ~16 the trail reads as a smear. */
  trail?: number;
  class?: string;
}

const {
  tint = "rgba(247, 245, 241, 0.07)",
  fade = 900,
  trail = 12,
  class: className = "",
} = Astro.props;
---

<div
  class:list={["cursor-trail", className]}
  aria-hidden="true"
  data-cursor-trail
  data-fade={fade}
  style={`--trail-tint:${tint};`}
>
  {Array.from({ length: trail }, () => <i class="cell"></i>)}
</div>

<style>
  .cursor-trail {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .cell {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--grid-cell);
    height: var(--grid-cell);
    background: var(--trail-tint);
    opacity: 0;
    /* no will-change, WAAPI promotes it while animating. 12 permanent layers
       for nothing otherwise */
  }
</style>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  // no mouse or reduced motion = do nothing at all
  if (fine.matches && !still.matches) {
    document.querySelectorAll<HTMLElement>("[data-cursor-trail]").forEach((plane) => {
      const size =
        parseFloat(getComputedStyle(plane).getPropertyValue("--grid-cell")) || 40;
      const fade = Number(plane.dataset.fade) || 900;
      const slots = Array.from(plane.querySelectorAll<HTMLElement>(".cell"));
      if (!slots.length) return;

      // where the module lines fall, document coords. measured not assumed
      let originX = 0;
      let originY = 0;
      // plane doesn't start at 0,0 of the document. assumed it did once, every
      // cell ended up pinned to the top
      let planeX = 0;
      let planeY = 0;
      let planeBottom = Infinity;

      function measure() {
        const pb = plane.getBoundingClientRect();
        planeX = pb.left;
        planeY = pb.top + window.scrollY;
        planeBottom = planeY + pb.height;

        // any .shell, they're all the same width
        const shell = document.querySelector<HTMLElement>(".shell");
        if (shell) {
          const box = shell.getBoundingClientRect();
          originX = box.left + (parseFloat(getComputedStyle(shell).paddingLeft) || 0);
        }
        // vertical has to be measured, there's no css for "where did this land".
        // page picks the anchor
        const anchor = document.querySelector<HTMLElement>("[data-grid-anchor]");
        if (anchor) {
          const top = anchor.getBoundingClientRect().top + window.scrollY;
          originY = ((top % size) + size) % size;
        }
      }

      measure();
      // fonts and images shift the anchor and neither fires resize
      new ResizeObserver(measure).observe(document.body);

      const running = new WeakMap<HTMLElement, Animation>();
      let next = 0;
      let lastCol = NaN;
      let lastRow = NaN;
      let pending: { x: number; y: number } | null = null;
      let frame = 0;

      function light(col: number, row: number) {
        const el = slots[next];
        next = (next + 1) % slots.length;

        // slot might still be fading, kill it or they stack and flicker
        running.get(el)?.cancel();

        el.style.transform = `translate3d(${col * size + originX - planeX}px, ${
          row * size + originY - planeY
        }px, 0)`;

        // snap on, drift off. WAAPI not a class toggle, restarting a css
        // transition forces a reflow per cell
        running.set(
          el,
          el.animate([{ opacity: 1 }, { opacity: 1, offset: 0.08 }, { opacity: 0 }], {
            duration: fade,
            easing: "ease-out",
          })
        );
      }

      function flush() {
        frame = 0;
        if (!pending) return;
        const { x, y } = pending;
        pending = null;
        // over the footer, the clip eats it anyway
        if (y < planeY || y >= planeBottom) {
          lastCol = NaN;
          lastRow = NaN;
          return;
        }
        const col = Math.floor((x - originX) / size);
        const row = Math.floor((y - originY) / size);
        if (col === lastCol && row === lastRow) return;
        lastCol = col;
        lastRow = row;
        light(col, row);
      }

      window.addEventListener(
        "pointermove",
        (e) => {
          if (e.pointerType !== "mouse") return;
          // plane is document space, pointer is viewport space
          pending = { x: e.clientX, y: e.clientY + window.scrollY };
          if (!frame) frame = requestAnimationFrame(flush);
        },
        { passive: true }
      );

      // leave the window and the last cell stays lit otherwise
      window.addEventListener("blur", () => {
        lastCol = NaN;
        lastRow = NaN;
      });
    });
  }
</script>
