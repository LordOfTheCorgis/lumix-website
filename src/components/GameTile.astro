---
// whole tile is the link. art carries recognition, price carries the
// decision, nothing here is red. the arrow goes to the game's accent on hover,
// it used to go red and that was a third red per viewport.
//
// accent from the yaml, in the hairline, hover only. tried a glow from the
// corner and a tinted edge at rest, evan cut both.
//
// height is seven cells so the bottom edge lands on the module. min not
// fixed, long taglines need somewhere to go

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { price } from "../lib/order";
import { links } from "../config";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  image: ImageMetadata;
  /** cheapest monthly. omit for planned */
  from?: number;
  planCount?: number;
  /** hex, from the yaml */
  accent: string;
  /** renders 56px tall top-left */
  logo: ImageMetadata;
  /** planned = dimmed in place, no price, no order link. same grid on
      purpose, a "coming soon" corner reads as an apology */
  status?: "live" | "beta" | "planned";
  eager?: boolean;
}

const {
  slug,
  name,
  tagline,
  image,
  from,
  planCount = 0,
  accent,
  logo,
  status = "live",
  eager = false,
} = Astro.props;

const planned = status === "planned";
// planned links to where you ask for it
const href = planned ? links.discord : `/games/${slug}`;
---

<a
  href={href}
  rel={planned ? "noopener" : undefined}
  class:list={[
    "tile group chamfer relative flex min-h-[calc(7*var(--grid-cell))] flex-col justify-end overflow-hidden border bg-ink-soft p-6 transition-colors duration-150",
    planned && "planned",
  ]}
  style={`--accent:${accent};`}
>
  <Image
    src={image}
    alt=""
    widths={[400, 800]}
    sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover opacity-70 transition-[opacity,transform] duration-300 group-hover:scale-[1.03] group-hover:opacity-85"
  />
  <!-- scrim not a tint, the art is dark and busy and text over it was unreadable -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-ink via-ink/75 to-ink/10"
    aria-hidden="true"
  >
  </div>

  <!-- publisher's logo, its own colours -->
  <Image
    src={logo}
    alt=""
    height={48}
    densities={[1, 2]}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="logo absolute left-6 top-6 h-12 w-auto max-w-[55%] object-contain object-left"
  />

  <div class="relative">
    <h3 class="title">{name}</h3>
    <!-- no reserved height, text hugs the price row -->
    <p class="small text-fog mt-1 line-clamp-2">{tagline}</p>

    {planned ? (
      <>
        <!-- same height as the price row or the grid ripples -->
        <div class="mt-3 flex items-baseline gap-2">
          <span class="title text-fog">Coming soon</span>
          <span
            aria-hidden="true"
            class="arrow ml-auto text-fog transition-colors duration-150"
          >&rarr;</span>
        </div>
        <p class="instrument text-slate mt-2">Ask for it in Discord</p>
      </>
    ) : (
      <>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="instrument text-slate">from</span>
          <span class="title tabular price">{price(from ?? 0)}</span>
          <span class="small text-fog">/mo</span>
          <span
            aria-hidden="true"
            class="arrow ml-auto text-fog transition-colors duration-150"
          >&rarr;</span>
        </div>
        <p class="instrument text-slate mt-2">
          {planCount === 1 ? "1 plan" : `${planCount} plans`}
        </p>
      </>
    )}
  </div>
</a>

<style>
  .tile {
    border-color: var(--edge);
  }

  .tile:hover {
    border-color: color-mix(in srgb, var(--accent) 75%, transparent);
  }

  .tile:hover .arrow {
    color: var(--accent);
  }

  .planned .logo {
    opacity: 0.45;
  }

  .planned h3 {
    color: var(--color-fog);
  }

  /* dimmed. art to a third, title to fog, accent still on hover */
  .planned :global(img) {
    opacity: 0.3;
  }

  .planned:hover :global(img) {
    opacity: 0.4;
  }

</style>
