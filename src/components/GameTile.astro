---
// The whole tile is the link. Key art carries the recognition, the price carries
// the decision, and nothing here is red: the hero button already spends the
// budget (DESIGN.md section 5). The arrow picks up the game's accent on hover,
// not red, which was the old behaviour and quietly a third red per viewport.
//
// Each tile carries its game's accent from the yaml, in the hairline, and only
// on hover. A panel on this site is its hairline (DESIGN.md rule 3), so that's
// where the colour goes; the arrow matches. At rest it's the normal edge.
// Went through a glow washing up from the corner, then a tinted edge at rest,
// and Evan cut both. The art already brings the colour, the edge names it
// when you reach for it.
//
// Height is seven cells rather than a round 256px so the bottom edge lands on
// the module the cursor trail snaps to. Stays a min, not a fixed height: a long
// tagline still needs somewhere to go.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { price } from "../lib/order";
import { links } from "../config";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  image: ImageMetadata;
  /** Cheapest monthly price. Omit for a planned game, there isn't one. */
  from?: number;
  planCount?: number;
  /** The game's own colour, from its yaml. Hex. */
  accent: string;
  /** The game's own logo, from the yaml. Rendered 56px tall, top-left. */
  logo: ImageMetadata;
  /** "planned" renders the tile dimmed in place with no price and no order
      link. Same grid as the live ones, on purpose: exiling them to a "coming
      soon" ghetto reads as an apology. */
  status?: "live" | "beta" | "planned";
  eager?: boolean;
}

const {
  slug,
  name,
  tagline,
  image,
  from,
  planCount = 0,
  accent,
  logo,
  status = "live",
  eager = false,
} = Astro.props;

const planned = status === "planned";
// A planned tile still links somewhere useful: the place to ask for it.
const href = planned ? links.discord : `/games/${slug}`;
---

<a
  href={href}
  rel={planned ? "noopener" : undefined}
  class:list={[
    "tile group chamfer relative flex min-h-[calc(7*var(--grid-cell))] flex-col justify-end overflow-hidden border bg-ink-soft p-6 transition-colors duration-150",
    planned && "planned",
  ]}
  style={`--accent:${accent};`}
>
  <Image
    src={image}
    alt=""
    widths={[400, 800]}
    sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover opacity-70 transition-[opacity,transform] duration-300 group-hover:scale-[1.03] group-hover:opacity-85"
  />
  <!-- Scrim, not a tint. Key art on these games is dark and busy, and text over
       it fails contrast without a real gradient underneath. -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-ink via-ink/75 to-ink/10"
    aria-hidden="true"
  >
  </div>

  <div class="relative">
    <!-- The logo is the title. Evan cut the text name on 2026-09-11: the
         publisher's mark identifies the game better than Inter does, and
         it's where the grid's colour comes from. The alt carries the name,
         so the link still reads "FiveM" to a screen reader and the h3 lives
         on as an sr-only for the document outline. -->
    <h3 class="sr-only">{name}</h3>
    <Image
      src={logo}
      alt={name}
      height={56}
      densities={[1, 2]}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="logo h-14 w-auto max-w-[70%] object-contain object-left"
    />
    <!-- Reserve both lines whether the copy fills them or not. The content is
         bottom-justified, so a one-line tagline used to shove the title 22px
         down the tile and Terraria sat visibly lower than Palworld beside it.
         line-clamp-2 caps the height but doesn't reserve it; 2lh does. -->
    <p class="small text-fog mt-4 line-clamp-2 min-h-[2lh]">{tagline}</p>

    {planned ? (
      <>
        <!-- Same height as the price row so the grid doesn't ripple. -->
        <div class="mt-5 flex items-baseline gap-2">
          <span class="title text-fog">Coming soon</span>
          <span
            aria-hidden="true"
            class="arrow ml-auto text-fog transition-colors duration-150"
          >&rarr;</span>
        </div>
        <p class="instrument text-slate mt-3">Ask for it in Discord</p>
      </>
    ) : (
      <>
        <div class="mt-5 flex items-baseline gap-2">
          <span class="instrument text-slate">from</span>
          <span class="title tabular price">{price(from ?? 0)}</span>
          <span class="small text-fog">/mo</span>
          <span
            aria-hidden="true"
            class="arrow ml-auto text-fog transition-colors duration-150"
          >&rarr;</span>
        </div>
        <p class="instrument text-slate mt-3">
          {planCount === 1 ? "1 plan" : `${planCount} plans`}
        </p>
      </>
    )}
  </div>
</a>

<style>
  .tile {
    border-color: var(--edge);
  }

  .tile:hover {
    border-color: color-mix(in srgb, var(--accent) 75%, transparent);
  }

  .tile:hover .arrow {
    color: var(--accent);
  }

  .planned .logo {
    opacity: 0.45;
  }

  /* Dimmed in place. Art drops to a third, the title to fog. The accent still
     comes up on hover so it doesn't read as dead, just not yet. */
  .planned :global(img) {
    opacity: 0.3;
  }

  .planned:hover :global(img) {
    opacity: 0.4;
  }

</style>
