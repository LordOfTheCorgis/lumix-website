---
// The whole tile is the link. Key art carries the recognition, the price carries
// the decision, and nothing here is red: the hero button already spends the
// budget (DESIGN.md section 5). The arrow picks up red on hover only.
import { price } from "../lib/order";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  image: string;
  from: number;
  planCount: number;
  eager?: boolean;
}

const { slug, name, tagline, image, from, planCount, eager = false } = Astro.props;
---

<a
  href={`/games/${slug}`}
  class="group chamfer relative flex min-h-64 flex-col justify-end overflow-hidden border border-[var(--edge)] bg-ink-soft p-6 transition-colors duration-150 hover:border-[var(--edge-strong)]"
>
  <img
    src={image}
    alt=""
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover opacity-45 transition-[opacity,transform] duration-300 group-hover:scale-[1.03] group-hover:opacity-60"
  />
  <!-- Scrim, not a tint. Key art on these games is dark and busy, and text over
       it fails contrast without a real gradient underneath. -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-ink via-ink/85 to-ink/25"
    aria-hidden="true"
  >
  </div>

  <div class="relative">
    <h3 class="title">{name}</h3>
    <p class="small text-fog mt-2 line-clamp-2">{tagline}</p>

    <div class="mt-5 flex items-baseline gap-2">
      <span class="instrument text-slate">from</span>
      <span class="title tabular">{price(from)}</span>
      <span class="small text-fog">/mo</span>
      <span
        aria-hidden="true"
        class="ml-auto text-fog transition-colors duration-150 group-hover:text-red"
      >&rarr;</span>
    </div>

    <p class="instrument text-slate mt-3">
      {planCount === 1 ? "1 plan" : `${planCount} plans`}
    </p>
  </div>
</a>
