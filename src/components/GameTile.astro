---
// The whole tile is the link. Key art carries the recognition, the price carries
// the decision, and nothing here is red: the hero button already spends the
// budget (DESIGN.md section 5). The arrow picks up red on hover only.
//
// Height is seven cells rather than a round 256px so the bottom edge lands on
// the module the cursor trail snaps to. Stays a min, not a fixed height: a long
// tagline still needs somewhere to go.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { price } from "../lib/order";

interface Props {
  slug: string;
  name: string;
  tagline: string;
  image: ImageMetadata;
  from: number;
  planCount: number;
  eager?: boolean;
}

const { slug, name, tagline, image, from, planCount, eager = false } = Astro.props;
---

<a
  href={`/games/${slug}`}
  class="group chamfer relative flex min-h-[calc(7*var(--grid-cell))] flex-col justify-end overflow-hidden border border-[var(--edge)] bg-ink-soft p-6 transition-colors duration-150 hover:border-[var(--edge-strong)]"
>
  <Image
    src={image}
    alt=""
    widths={[400, 800]}
    sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover opacity-45 transition-[opacity,transform] duration-300 group-hover:scale-[1.03] group-hover:opacity-60"
  />
  <!-- Scrim, not a tint. Key art on these games is dark and busy, and text over
       it fails contrast without a real gradient underneath. -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-ink via-ink/85 to-ink/25"
    aria-hidden="true"
  >
  </div>

  <div class="relative">
    <h3 class="title">{name}</h3>
    <!-- Reserve both lines whether the copy fills them or not. The content is
         bottom-justified, so a one-line tagline used to shove the title 22px
         down the tile and Terraria sat visibly lower than Palworld beside it.
         line-clamp-2 caps the height but doesn't reserve it; 2lh does. -->
    <p class="small text-fog mt-2 line-clamp-2 min-h-[2lh]">{tagline}</p>

    <div class="mt-5 flex items-baseline gap-2">
      <span class="instrument text-slate">from</span>
      <span class="title tabular">{price(from)}</span>
      <span class="small text-fog">/mo</span>
      <span
        aria-hidden="true"
        class="ml-auto text-fog transition-colors duration-150 group-hover:text-red"
      >&rarr;</span>
    </div>

    <p class="instrument text-slate mt-3">
      {planCount === 1 ? "1 plan" : `${planCount} plans`}
    </p>
  </div>
</a>
