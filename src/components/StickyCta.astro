---
// mobile only, shows once the hero button has scrolled off. hidden at md+
// where the header button is on screen

interface Props {
  href?: string;
  label?: string;
}

const { href = "/#pick", label = "Order a server" } = Astro.props;
---

<div
  data-sticky-cta
  hidden
  class="fixed inset-x-0 bottom-0 z-40 border-t border-[var(--edge)] bg-ink/95 backdrop-blur-md md:hidden"
>
  <div class="shell py-3">
    <a
      href={href}
      class="chamfer flex items-center justify-center gap-2 bg-red px-6 py-3.5 font-medium text-ink"
    >
      {label}
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky-cta]");

  if (bar) {
    // past roughly one screen. scrollY not an observer so it works on pages
    // with no hero
    const threshold = () => Math.min(window.innerHeight * 0.8, 640);

    const update = () => {
      const show = window.scrollY > threshold();
      if (show === bar.hidden) {
        bar.hidden = !show;
        // keep it off the footer
        document.body.style.paddingBottom = show ? `${bar.offsetHeight}px` : "";
      }
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>
