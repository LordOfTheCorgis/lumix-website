---
// Stripped back to the shell. Every meta tag, canonical and schema block below is
// load-bearing for SEO and survived the teardown untouched. What's gone: Header,
// Footer, AnnouncementBanner, the body padding that compensated for the banner,
// and the blanket IntersectionObserver that fade-in-up'd basically every element
// on the site. DESIGN.md section 9 says one orchestrated moment, on the Capacity
// Board, once. That observer was the opposite of that.
//
// TODO: rebuild Header + Footer against the new system before this ships anywhere.

import "../styles/global.css";
import { siteConfig } from "../data/site";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  noindex = false
} = Astro.props;

const absoluteSiteUrl = `https://${siteConfig.domain}`;
const absoluteLogoUrl = `${absoluteSiteUrl}${siteConfig.logo}`;
const absoluteSocialImageUrl = `${absoluteSiteUrl}${siteConfig.socialImage ?? siteConfig.logo}`;
const canonicalUrl = new URL(Astro.url.pathname, absoluteSiteUrl).href;
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const brandName = "Lumix Solutions";
const pageTitle = title.includes(brandName) ? title : `${title} | ${brandName}`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: brandName,
  url: absoluteSiteUrl,
  logo: absoluteLogoUrl
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: brandName,
  url: absoluteSiteUrl
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#e7e8e3" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Lumix Solutions" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteSocialImageUrl} />
    <meta property="og:image:secure_url" content={absoluteSocialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lumix Solutions branded preview image" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteSocialImageUrl} />
    <meta name="twitter:image:alt" content="Lumix Solutions branded preview image" />

    <!-- Archivo carries both the display and body voice via its width axis, so
         this is one file doing two jobs. Martian Mono is instrument labels only. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@75..112.5,100..800&display=swap"
      rel="stylesheet"
    />

    <!-- Versioned favicon URLs help bust stale crawler and CDN caches -->
    <link rel="icon" href="/favicon.ico?v=20260419" sizes="any" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/logo.png?v=20260419" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-board text-ink">
    <main class="flex-1">
      <slot />
    </main>
  </body>
</html>
