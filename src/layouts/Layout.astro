---
// The shell. SEO tags, the two typefaces, and a slot. Header and Footer get built
// against the new system when there's a system to build them against.
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import CookieBanner from "../components/CookieBanner.astro";
import GridPattern from "../components/GridPattern.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Absolute or root-relative path. Defaults to the brand card. */
  image?: string;
}

const DEFAULT_DESCRIPTION =
  "Game server hosting for communities. A finite number of servers, run properly.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  image = "/images/og-image.png",
} = Astro.props;

const siteUrl = "https://lumixsolutions.org";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const brandName = "Lumix Solutions";
const pageTitle = title.includes(brandName) ? title : `${title} | ${brandName}`;
// OG scrapers do not resolve relative URLs. Always absolute.
const ogImage = new URL(image, siteUrl).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: brandName,
  url: siteUrl
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#121214" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lumix Solutions" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Space Grotesk for display, Inter for everything read at length. Both
         variable, one request. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <title>{pageTitle}</title>

    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col text-paper">
    <!-- Sits at z-index -1 under everything, which only works because the ink
         ground is on <html> and body is transparent. -->
    <GridPattern />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <CookieBanner />
  </body>
</html>
