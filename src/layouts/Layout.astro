---
// the shell: seo tags, fonts, a slot
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import CookieBanner from "../components/CookieBanner.astro";
import CursorTrail from "../components/CursorTrail.astro";
import PromoBar from "../components/PromoBar.astro";
import Analytics from "../components/Analytics.astro";
import { links } from "../config";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** absolute or root-relative. defaults to the brand card */
  image?: string;
  /** what the og image shows, for screen readers and scrapers */
  imageAlt?: string;
  /** mobile order bar. off for pages that need the bottom edge (tools) */
  stickyCta?: boolean;
}

const DEFAULT_DESCRIPTION =
  "Game server hosting for communities. A finite number of servers, run properly.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  noindex = false,
  image = "/images/og-image.png",
  imageAlt = "Lumix Solutions",
  stickyCta = true,
} = Astro.props;

// dev.lumixsolutions.org builds with PUBLIC_DEPLOY_ENV=dev (deploy-dev.yml).
// Every page there goes noindex so Google never ranks the staging copy, and
// robots.txt.ts disallows the crawl on top of it.
const isDev = import.meta.env.PUBLIC_DEPLOY_ENV === "dev";

const siteUrl = "https://lumixsolutions.org";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const brandName = "Lumix Solutions";
const pageTitle = title.includes(brandName) ? title : `${title} | ${brandName}`;
// og scrapers don't resolve relative urls
const ogImage = new URL(image, siteUrl).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: brandName,
  url: siteUrl,
  logo: `${siteUrl}/icon-512.png`,
  // entity signal: ties the domain to the accounts Google already knows
  sameAs: [links.discord, links.x, links.instagram, links.tiktok, links.github],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || isDev ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#161114" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- both variable, one request -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <title>{pageTitle}</title>

    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col text-paper">
    <!-- trail plane is positioned against this wrapper so it stops at the
         footer. off body it runs behind the footer, off nothing it clips at
         100vh. z -1 works because the ground is on html and body is
         transparent -->
    <div class="relative flex flex-1 flex-col">
      <CursorTrail />
      <PromoBar />
      <Header />
      <main class="flex-1">
        <slot />
      </main>
    </div>
    <Footer />
    {stickyCta && <StickyCta />}
    <CookieBanner />
  </body>
</html>
