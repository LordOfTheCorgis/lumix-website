---
// The shell. SEO tags, the two typefaces, and a slot. Header and Footer get built
// against the new system when there's a system to build them against.
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  "Game server hosting for communities. A finite number of servers, run properly.";

const { title, description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props;

const siteUrl = "https://lumixsolutions.org";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const brandName = "Lumix Solutions";
const pageTitle = title.includes(brandName) ? title : `${title} | ${brandName}`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: brandName,
  url: siteUrl
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#e7e8e3" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Archivo carries both display and body off its width axis, so this is one
         file doing two jobs. Martian Mono is instrument labels only. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Martian+Mono:wdth,wght@75..112.5,100..800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-board text-ink">
    <main class="flex-1">
      <slot />
    </main>
  </body>
</html>
