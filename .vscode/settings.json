{
  "css.validate": false,
  "css.lint.unknownAtRules": "ignore",
  "editor.quickSuggestions": {
    "strings": true
  },
  "tailwindCSS.experimental.classRegex": [],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    "dist": true,
    ".astro": true
  },
  "search.exclude": {
    "dist": true,
    ".astro": true,
    "node_modules": true
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/.astro/**": true,
    "**/node_modules/**": true
  }
}
